{
  "name": "poapkings.com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "postinstall": "patch-package",
    "backfill-data": "node scripts/backfill-cr-history.js",
    "update-recognition": "node scripts/update-recognition.js",
    "update-roster": "node scripts/update-roster.js",
    "test": "node --test tests/",
    "infra:generate": "node infra/templates.mjs",
    "infra": "node scripts/infra.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@aws-sdk/client-acm": "^3.1157.0",
    "@aws-sdk/client-cloudformation": "^3.1157.0",
    "@aws-sdk/client-cloudfront": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/client-sts": "^3.1157.0",
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "motion": "^13.4.2",
    "pixi.js": "^8.22.0"
  }
}
