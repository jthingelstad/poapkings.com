---
layout: base.njk
pagination:
  data: awards.seasons
  size: 1
  alias: season
navActive: awards
eleventyComputed:
  permalink: "/awards/s{{ season.season_id }}/"
  title: "Season {{ season.season_id }} Awards | POAP KINGS"
  description: "POAP KINGS Season {{ season.season_id }} award winners — war champs, donation champs, rookie MVPs, Iron Kings, and more."
---
<section class="section" style="padding-top: clamp(36px, 5vw, 64px); padding-bottom: clamp(20px, 3vw, 40px);">
  <a class="back-link" href="/awards/">← All awards</a>
  <span class="eyebrow mt-3" style="display:inline-flex">Season Awards</span>
  <h1 class="h-display h1 mt-4">Season {{ season.season_id }}</h1>
  <p class="lede mt-4">
    {{ season.season_start | formatLongDate }} – {{ season.season_end | formatLongDate }} · {{ season.awardCount }} award{{ "s" if season.awardCount != 1 }} handed out
    {%- if not season.byType.war_champ or season.byType.war_champ.length == 0 %} · <span class="pill pill--live pill--dot" style="margin-left:6px;vertical-align:middle">Season in progress</span>{% endif %}
  </p>
</section>

<hr class="rule" />

{% for category in season.categories %}
<section class="section--tight">
  <div class="cat-head">
    <div>
      <h3 class="h-display">{{ category.label }}</h3>
      <p class="cat-head__desc">{{ category.description }}</p>
    </div>
    <span class="pill {% if category.style == 'podium' %}pill--gold{% else %}pill--purple{% endif %}">Season honor</span>
  </div>

  {% if category.style == "podium" %}
  <ol class="rankbar">
    {% for a in category.awards %}
    <li class="rankbar__row rankbar__row--rank{{ a.rank }}">
      <div class="rankbar__numeral">{% if a.rank < 10 %}0{% endif %}{{ a.rank }}</div>
      <div class="rankbar__body">
        {%- set tierLabel = "Gold" if a.rank == 1 else ("Silver" if a.rank == 2 else ("Bronze" if a.rank == 3 else "Honor")) -%}
        <span class="rankbar__tier">{{ tierLabel }} · {{ category.singular }}</span>
        <a class="rankbar__name" href="/roster/#member-{{ a.player_tag | memberSlug }}">{{ a.player_name | e }}</a>
        {% if a.metadata.races_participated %}<div class="rankbar__note">{{ a.metadata.races_participated }} race{{ "s" if a.metadata.races_participated != 1 }}{% if a.metadata.avg_fame %} · avg {{ a.metadata.avg_fame | formatNumber }} fame{% endif %}</div>{% endif %}
      </div>
      <div class="rankbar__metric">
        <span class="rankbar__big">{{ a.metric_value | formatNumber }}</span>
        <span class="rankbar__unit">{{ a.metric_unit }}</span>
      </div>
    </li>
    {% endfor %}
  </ol>

  {% elif category.style == "honorRoll" %}
  <ul class="honor-roll">
    {% for a in category.awards %}
    <li>
      <a href="/roster/#member-{{ a.player_tag | memberSlug }}">
        <span class="honor-roll__eyebrow">{{ category.singular | upper }}</span>
        <span class="honor-roll__name">{{ a.player_name | e }}</span>
        {% if a.metadata.total_battle_days %}<span class="honor-roll__metric">{{ a.metadata.total_battle_days }} battle days</span>{% endif %}
      </a>
    </li>
    {% endfor %}
  </ul>

  {% elif category.type == "perfect_week" %}
  <ul class="honor-roll" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))">
    {% for week in season.perfectWeekBySection %}
    <li>
      <a href="#" style="pointer-events:none">
        <span class="honor-roll__eyebrow">{{ week.week_label | upper }}</span>
        <span class="honor-roll__name" style="font-size:14px">
          {% for a in week.awards %}{{ a.player_name | e }}{% if not loop.last %}, {% endif %}{% endfor %}
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>

  {% elif category.type == "donation_champ_weekly" %}
  <ul class="honor-roll" style="grid-template-columns: repeat(auto-fill, minmax(240px, 1fr))">
    {% for week in season.donationChampWeeklyBySection %}
    <li>
      <a href="#" style="pointer-events:none">
        <span class="honor-roll__eyebrow">{{ week.week_label | upper }}{% if week.week_ending %} · ENDS {{ week.week_ending | formatDate | upper }}{% endif %}</span>
        <span class="honor-roll__name" style="font-size:14px">
          {% for a in week.awards %}#{{ a.rank }} {{ a.player_name | e }}{% if not loop.last %}, {% endif %}{% endfor %}
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>

  {% else %}
  <ul class="honor-roll" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))">
    {% for a in category.awards %}
    <li>
      <a href="/roster/#member-{{ a.player_tag | memberSlug }}">
        <span class="honor-roll__eyebrow">{{ category.singular | upper }}</span>
        <span class="honor-roll__name">{{ a.player_name | e }}</span>
        <span class="honor-roll__metric">{{ a.metric_value | formatNumber }} {{ a.metric_unit }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endfor %}

<hr class="rule" />

<section class="section--tight">
  <div class="ctaRow" style="justify-content:space-between">
    {% if season.olderSeasonId %}
    <a class="btn btn--ghost" href="/awards/s{{ season.olderSeasonId }}/">← Season {{ season.olderSeasonId }}</a>
    {% else %}
    <span></span>
    {% endif %}
    <a class="btn btn--ghost" href="/awards/">All awards</a>
    {% if season.newerSeasonId %}
    <a class="btn btn--ghost" href="/awards/s{{ season.newerSeasonId }}/">Season {{ season.newerSeasonId }} →</a>
    {% else %}
    <span></span>
    {% endif %}
  </div>
</section>
