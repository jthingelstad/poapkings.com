---
permalink: /wars/
layout: base.njk
title: Clan Wars | POAP KINGS | Clash Royale War History
description: "POAP KINGS Clan Wars history from Clash Royale API data: river race seasons, weekly ranks, trophy changes, fame, and clan score."
navActive: wars
---
{%- set summary = warHistory.summary -%}

<header class="roster-head war-head">
  <div class="roster-head__copy">
    <span class="eyebrow">Clan Wars</span>
    <h1 class="h-display h1">River race history</h1>
    <p class="lede">Season-by-season war performance, stored from Clash Royale API river race data. The history can skip dates when we did not collect, but each recorded week is anchored to the API season and section.</p>
  </div>
  <div class="roster-head__meta">
    <div class="m"><div class="m__n">{{ summary.totalWeeks }}</div><div class="m__l">Weeks tracked</div></div>
    <div class="m"><div class="m__n">{{ summary.wins }}</div><div class="m__l">First-place weeks</div></div>
    <div class="m"><div class="m__n">+{{ summary.trophyChange | formatNumber }}</div><div class="m__l">War trophies</div></div>
  </div>
</header>

<section class="section--tight">
  <div class="war-summary">
    <div>
      <span class="kicker">Latest recorded race</span>
      {% if summary.latestWeek %}
      <strong>{{ summary.latestWeek.weekLabel }}</strong>
      <span>Rank #{{ summary.latestWeek.rank }} · {{ summary.latestWeek.fame | formatNumber }} fame · {{ summary.latestWeek.trophyChange | formatNumber }} trophies</span>
      {% else %}
      <strong>No history yet</strong>
      <span>Run the roster updater locally to pull river race history.</span>
      {% endif %}
    </div>
    <div>
      <span class="kicker">Average rank</span>
      <strong>#{{ summary.averageRank | formatDecimal(1) }}</strong>
      <span>Across recorded river race weeks</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Season view</span>
      <h2 class="h-display h2 mt-3">Weekly results by season.</h2>
    </div>
  </div>

  <div class="season-grid">
    {% for season in warHistory.seasons %}
    <article class="season-row">
      <div class="season-row__label">
        <strong>Season {{ season.seasonId }}</strong>
        <span>{{ season.wins }} win{{ "s" if season.wins != 1 }} · {{ season.trophyChange | formatNumber }} trophies</span>
      </div>
      <div class="season-row__weeks">
        {% for week in season.weeks %}
        <div class="war-week{% if week.rank == 1 %} war-week--win{% endif %}{% if week.isColosseum %} war-week--colosseum{% endif %}" title="{{ week.weekLabel }} · rank #{{ week.rank }} · {{ week.fame | formatNumber }} fame">
          <span>W{{ week.sectionIndex + 1 }}</span>
          <strong>#{{ week.rank }}</strong>
          <small>{% if week.trophyChange > 0 %}+{% endif %}{{ week.trophyChange }}</small>
        </div>
        {% endfor %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow eyebrow--purple">Week ledger</span>
      <h2 class="h-display h2 mt-3">Recorded river races.</h2>
    </div>
  </div>

  <div class="roster-table-wrap">
    <table class="roster-table war-table">
      <caption class="sr-only">POAP KINGS Clan Wars recorded river races</caption>
      <thead>
        <tr>
          <th scope="col">Week</th>
          <th scope="col">Created</th>
          <th scope="col" class="num">Rank</th>
          <th scope="col" class="num">Fame</th>
          <th scope="col" class="num">War Trophies</th>
          <th scope="col" class="num">Clan Score</th>
          <th scope="col">Type</th>
        </tr>
      </thead>
      <tbody>
        {% for week in warHistory.weeks | reverse %}
        <tr>
          <td class="roster-table__member" data-label="Week">
            <span class="roster-table__name">{{ week.weekLabel }}</span>
            <span class="roster-table__sub">Season {{ week.seasonId }} · section {{ week.sectionIndex }}</span>
          </td>
          <td data-label="Created">{{ week.createdDate | formatLastSeen }}</td>
          <td class="num" data-label="Rank">#{{ week.rank }}</td>
          <td class="num" data-label="Fame">{{ week.fame | formatNumber }}</td>
          <td class="num" data-label="War trophies">{% if week.trophyChange > 0 %}+{% endif %}{{ week.trophyChange | formatNumber }}</td>
          <td class="num" data-label="Clan score">{{ week.clanScore | formatNumber }}</td>
          <td data-label="Type"><span class="pill {% if week.isColosseum %}pill--purple{% else %}pill--gold{% endif %}">{{ "Colosseum" if week.isColosseum else "Race week" }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
