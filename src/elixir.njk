{% from "components.njk" import backLink, sectionHeading, actionLink, numberedCard %}
<div class="pk-page pk-page--elixir pk-page-shell">
  {{ backLink('/', 'Back home') }}

  <section class="pk-elixir-hero pk-elixir-banner">
    <img class="pk-elixir-banner__image" src="/assets/elixir-logo.webp" alt="Elixir logo" width="512" height="512">
    <div>
      <span class="pk-eyebrow pk-eyebrow--gold">Powered by Elixir</span>
