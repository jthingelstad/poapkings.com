  <section class="pk-section">
    {{ sectionHeading('What Elixir does', 'One agent, many jobs') }}
    <div class="pk-grid-3 pk-elixir-jobs">
      {%- set elixirJobs = [
        { num: '01', title: 'Publishes the Elder Standing', body: 'Every Tuesday, Elixir posts a transparent ranking of who\'s competing for the clan — so Elder is never a mystery or a favor.' },
        { num: '02', title: 'Runs season recognition', body: 'War Champ, Iron King, Rookie MVP, Donation Champ, and the Free Pass rotation all come from deterministic rules and durable season results.' },
        { num: '03', title: 'Knows the whole roster', body: 'Trophies, donations, tenure, battles, war results, and member history give Elixir the context to answer questions without guessing.' },
        { num: '04', title: 'Tells the clan\'s story', body: 'Every week Elixir sends a clan recap email — who climbed, who carried war, the milestones and the near-misses. The story of the week, written down so it isn\'t forgotten.' },
        { num: '05', title: 'Coaches every member', body: 'A personal weekly arena recap lands in each member\'s inbox: your highlights, what moved, and specific coaching on exactly where to sharpen next.' },
