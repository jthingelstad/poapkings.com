{#- How our clans use Elixir. Elixir is for any player and its own site does
    the explaining, so this page says what members get and links out. Every
    claim here follows Elixir's own docs and What's new; when Elixir changes
    what it does, change this page. -#}
{% from "components.njk" import backLink, sectionHeading, actionLink, numberedCard %}
<div class="pk-page pk-page--elixir pk-page-shell">
  {{ backLink('/', 'Back home') }}

  <section class="pk-elixir-hero pk-elixir-banner">
    <img class="pk-elixir-banner__image" src="/assets/elixir-logo.webp" alt="Elixir logo" width="512" height="512">
    <div>
      <span class="pk-eyebrow pk-eyebrow--gold">Powered by Elixir</span>
      <h1 class="pk-elixir-banner__title">Elixir</h1>
      <p class="pk-elixir-banner__copy">Elixir is the missing social layer of Clash Royale, and POAP KINGS built it. Follow your friends and your clan, see how they play, and cheer them on. It is free for any player, and <a href="/clans/">our clans</a> run on it.</p>
      <div class="pk-drop-actions">
        {{ actionLink('https://elixir.poapkings.com/', 'Visit Elixir ↗', 'gold', 'elixir.visit', true) }}
        {{ actionLink('https://elixir.poapkings.com/signin?signup', 'Create an account', 'outline', 'elixir.request', true) }}
      </div>
    </div>
  </section>

  <section class="pk-section">
    {{ sectionHeading('In our clans', 'What Elixir does for members') }}
    <div class="pk-grid-3 pk-elixir-jobs">
      {%- set elixirJobs = [
        { num: '01', title: 'Follow your clanmates', body: 'Add your player and Elixir suggests people you know: clanmates, 2v2 teammates and anyone you played a friendly battle with. Nobody is followed until you say so.' },
        { num: '02', title: 'One feed of their play', body: 'Home shows what the people you follow played: each sitting of battles, a new Arena or league, and the battles they chose to highlight.' },
        { num: '03', title: 'Cheer them on', body: 'Any item in the feed can take a cheer, one of six, from Well played to Grind.' },
        { num: '04', title: 'Remembers your battles', body: 'The game shows your last few dozen battles. Elixir keeps the ones it records for a year, with river races and roster history, and your own Stats read from them.' },
        { num: '05', title: 'One email, your choice', body: 'A digest of the people you follow and your clan\'s week, on Monday or every day. Every kind of email is a switch you control.' },
        { num: '06', title: 'Clan, for leaders and members', body: 'Standing, the Elder band and the actions waiting for a leader, judged by each clan\'s own written policy, never by a default. Members see where they stand.' }
      ] -%}
      {%- for j in elixirJobs %}
      {{ numberedCard(j.num, j.title, j.body) }}
      {%- endfor %}
    </div>
  </section>

  <section class="pk-section">
    {{ sectionHeading('For any player', 'Built by POAP KINGS, open to everyone', actionLink('https://github.com/jthingelstad/elixir-mcp', 'View the code on GitHub →', 'outline', 'elixir.github', true)) }}
    <p class="pk-elixir-tech-copy">Elixir started as POAP KINGS' own clan bot. It is now a place <strong>any player or clan can use</strong>, and its own site is the place to learn about it: how to follow a friend, what it records, and how to connect your own AI agent to your record. Accounts are free and open to anyone, and Elixir is <strong>built in the open</strong>.</p>
    <div class="pk-tech3">
      {%- set elixirLinks = [
        { label: 'The site', value: 'elixir.poapkings.com', href: 'https://elixir.poapkings.com/', key: 'home' },
        { label: 'Getting started', value: 'Quickstart', href: 'https://elixir.poapkings.com/docs/quickstart', key: 'quickstart' },
        { label: 'Your friends', value: 'Follow a friend', href: 'https://elixir.poapkings.com/docs/follow-a-friend', key: 'follow' },
        { label: 'For clan leaders', value: 'Clan', href: 'https://elixir.poapkings.com/clan', key: 'clan' },
        { label: 'For your own AI', value: 'Connect an agent', href: 'https://elixir.poapkings.com/docs/connect-a-client', key: 'agent' },
        { label: 'An experiment', value: 'The Discord agent', href: 'https://github.com/jthingelstad/elixir-mcp-discord', key: 'discord' }
      ] -%}
      {%- for l in elixirLinks %}
      <a class="pk-tech-fact pk-tech-fact--link" href="{{ l.href }}" target="_blank" rel="noreferrer" data-tinylytics-event="elixir.link-{{ l.key }}">
        <span class="pk-tech-fact__label">{{ l.label }}</span>
        <strong class="pk-tech-fact__value">{{ l.value }} ↗</strong>
      </a>
      {%- endfor %}
    </div>
  </section>

  <a class="pk-elixir-game" href="/clans/">
    <div>
      <h3 class="pk-elixir-game__title">Meet the clans it runs</h3>
      <p class="pk-elixir-game__copy">POAP KINGS, Ship It! and Elixir Kings: three clans, one Discord.</p>
    </div>
    <span class="pk-elixir-game__cta">Our clans →</span>
  </a>

  <a class="pk-elixir-game" href="/elixir-drop/">
    <div>
      <h3 class="pk-elixir-game__title">We also make a game</h3>
      <p class="pk-elixir-game__copy">Elixir Drop is our card-and-cost trainer — the same mascot, cheering your reads and ribbing the misses.</p>
    </div>
    <span class="pk-elixir-game__cta">Learn about Elixir Drop →</span>
  </a>
</div>
