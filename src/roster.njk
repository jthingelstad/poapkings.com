---
permalink: /roster/
layout: base.njk
title: Roster | POAP KINGS | A Clash Royale Clan with Proof
description: "POAP KINGS roster — current clan members, roles, trophies, career wins, years played, collection level, badge count, and clan rank."
navActive: roster
---
{%- set sortedMembers = elixirRoster.members | sortByRank -%}
{%- set memberCount = elixirRoster.members | length -%}
{%- set openSlots = 50 - memberCount -%}
{%- set isFull = memberCount >= 50 -%}

<header class="roster-head">
  <div class="roster-head__copy">
    <span class="eyebrow">The Kings · {{ elixirRoster.updated | formatDate }}</span>
    <h1 class="h-display h1">Roster table</h1>
    {% if isFull %}
    <p class="lede"><strong style="color:var(--gold)">Clan is full — all 50 seats taken.</strong> Search and sort the current roster by rank, role, trophies, career wins, account depth, and donations. Want in? <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" style="color:#fff;border-bottom:1px solid var(--hairline-2)">Join the waitlist in Discord</a>.</p>
    {% else %}
    <p class="lede">{{ memberCount }} active{% if openSlots > 0 %}, {{ openSlots }} open{% endif %}. Search and sort the current roster by rank, role, trophies, career wins, account depth, and donations.</p>
    {% endif %}
  </div>
  <div class="roster-head__meta">
    <div class="m"><div class="m__n">{{ memberCount }}</div><div class="m__l">Members</div></div>
    {% if isFull %}
    <div class="m m--full"><div class="m__n m__n--full"><span class="roster-full-dot"></span>FULL</div><div class="m__l">Waitlist open</div></div>
    {% else %}
    <div class="m"><div class="m__n">{{ openSlots }}</div><div class="m__l">Open slots</div></div>
    {% endif %}
    <div class="m"><div class="m__n">{{ elixirClan.clanScore | formatNumber }}</div><div class="m__l">Clan trophies</div></div>
  </div>
</header>

<div class="cardtools roster-table-tools">
  <div class="cardtools__search">
    <input id="rosterSearch" type="search" placeholder="Search name, tag, arena, stat..." aria-label="Search roster" />
  </div>
  <div class="cardtools__chips" id="roleChips">
    <button class="chip is-active" data-role="all" type="button">All</button>
    <button class="chip" data-role="leadership" type="button">Leadership</button>
    <button class="chip" data-role="elder" type="button">Elders</button>
    <button class="chip" data-role="member" type="button">Members</button>
  </div>
  <div class="cardtools__sort">
    <label for="rosterSort">Sort</label>
    <select id="rosterSort">
      <option value="rank" selected>Clan rank</option>
      <option value="trophies">Trophies</option>
      <option value="wins">Career wins</option>
      <option value="collection">Collection level</option>
      <option value="years">Years played</option>
      <option value="badges">Badges</option>
      <option value="donations">Donations</option>
      <option value="alpha">Alphabetical</option>
    </select>
  </div>
  <div class="cardtools__count" aria-live="polite"><span id="rosterStatus">{{ memberCount }}</span> showing</div>
</div>

<div class="roster-table-wrap">
  <table class="roster-table" id="rosterTable">
    <caption class="sr-only">Current POAP KINGS clan roster</caption>
    <thead>
      <tr>
        <th scope="col">Rank</th>
        <th scope="col">Member</th>
        <th scope="col">Role</th>
        <th scope="col" class="num">Trophies</th>
        <th scope="col" class="num">Wins</th>
        <th scope="col" class="num">Collection</th>
        <th scope="col" class="num">Years</th>
        <th scope="col" class="num">Badges</th>
        <th scope="col" class="num">Donated</th>
        <th scope="col" class="num">War wins</th>
        <th scope="col">Last seen</th>
      </tr>
    </thead>
    <tbody id="rosterRows">
      {% for m in sortedMembers %}
      {%- set rawRole = m.role if m.role else "Member" -%}
      {%- set roleSlug = rawRole | lower | replace("-", "") -%}
      {%- set rawTag = m.tag | replace("#", "") -%}
      <tr id="member-{{ rawTag | lower | e }}"
        data-search="{{ m | searchText | e }}"
        data-trophies="{{ m.trophies or 0 }}"
        data-donations="{{ m.donations or 0 }}"
        data-wins="{{ m.cr_battle_wins or 0 }}"
        data-collection="{{ m.cr_collection_level or 0 }}"
        data-years="{{ m.cr_account_age_days or 0 }}"
        data-badges="{{ m.badge_count or 0 }}"
        data-rank="{{ m.clan_rank or 999 }}"
        data-name="{{ m.name | e }}"
        data-role="{{ roleSlug }}">
        <td class="roster-table__rank" data-label="Rank">#{{ m.clan_rank or "—" }}</td>
        <td class="roster-table__member" data-label="Member">
          <span class="roster-table__name">{{ m.name | e }}</span>
          <span class="roster-table__sub">#{{ rawTag | upper | e }} · {{ m.arena or "Unranked" }}</span>
        </td>
        <td data-label="Role"><span class="roster-role roster-role--{{ roleSlug }}">{{ rawRole | e }}</span></td>
        <td class="num" data-label="Trophies">{{ m.trophies | formatNumber }}</td>
        <td class="num" data-label="Wins">{% if m.cr_battle_wins %}{{ m.cr_battle_wins | formatNumber }}{% else %}—{% endif %}</td>
        <td class="num" data-label="Collection">{% if m.cr_collection_level %}{{ m.cr_collection_level | formatNumber }}{% else %}—{% endif %}</td>
        <td class="num" data-label="Years" title="{% if m.cr_account_age_days %}{{ m.cr_account_age_days | formatNumber }} days played{% endif %}">{{ m.cr_account_age_years | formatYearsPlayed(m.cr_account_age_days) }}</td>
        <td class="num" data-label="Badges">{{ m.badge_count or 0 }}</td>
        <td class="num" data-label="Donated">{{ m.donations | formatNumber }}</td>
        <td class="num" data-label="War wins">{% if m.cr_clan_war_wins or m.cr_clan_war_wins == 0 %}{{ m.cr_clan_war_wins | formatNumber }}{% else %}—{% endif %}</td>
        <td data-label="Last seen">{% if m.last_seen %}{{ m.last_seen | formatLastSeen }}{% else %}—{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% if openSlots > 0 %}
<button type="button" class="roster-open-note" data-modal-open="join" data-tinylytics-event="roster.open-slot">
  <strong>{{ openSlots }} open slot{{ "s" if openSlots != 1 }}</strong>
  <span>{{ elixirClan.minTrophies | formatNumber }}+ trophies, daily play, good vibes.</span>
</button>
{% endif %}

<div class="empty-state" id="rosterEmpty" hidden>
  <h3>No members match that filter.</h3>
  <p>Try another role, search term, or sort.</p>
</div>

<script>
(function(){
  var body = document.getElementById('rosterRows');
  var statusEl = document.getElementById('rosterStatus');
  var emptyEl = document.getElementById('rosterEmpty');
  var searchEl = document.getElementById('rosterSearch');
  var sortEl = document.getElementById('rosterSort');
  var chipWrap = document.getElementById('roleChips');
  if (!body) return;

  var rows = Array.prototype.slice.call(body.querySelectorAll('tr'));
  var state = { role: 'all', q: '', sort: 'rank' };

  function num(el, k){
    var v = el.dataset[k];
    return v == null || v === '' ? 0 : Number(v);
  }

  function str(el, k){
    return el.dataset[k] || '';
  }

  function visibleByFilter(row){
    var role = row.dataset.role || 'member';
    if (state.role === 'leadership' && !/leader/.test(role)) return false;
    if (state.role === 'elder' && role !== 'elder') return false;
    if (state.role === 'member' && (role === 'elder' || /leader/.test(role))) return false;
    if (state.q){
      var hay = (row.dataset.search || '') + ' ' + (row.dataset.name || '').toLowerCase();
      if (hay.indexOf(state.q) === -1) return false;
    }
    return true;
  }

  function compare(a, b){
    switch (state.sort){
      case 'trophies':   return num(b, 'trophies') - num(a, 'trophies');
      case 'donations':  return num(b, 'donations') - num(a, 'donations');
      case 'wins':       return num(b, 'wins') - num(a, 'wins');
      case 'collection': return num(b, 'collection') - num(a, 'collection');
      case 'years':      return num(b, 'years') - num(a, 'years');
      case 'badges':     return num(b, 'badges') - num(a, 'badges');
      case 'alpha':      return str(a, 'name').localeCompare(str(b, 'name'));
      default:           return num(a, 'rank') - num(b, 'rank');
    }
  }

  function render(){
    var visible = rows.filter(visibleByFilter).sort(compare);
    rows.forEach(function(row){ row.hidden = true; });
    visible.forEach(function(row){
      row.hidden = false;
      body.appendChild(row);
    });
    if (statusEl) statusEl.textContent = visible.length;
    if (emptyEl) emptyEl.hidden = visible.length > 0;
  }

  if (searchEl) searchEl.addEventListener('input', function(e){
    state.q = e.target.value.trim().toLowerCase();
    render();
  });

  if (sortEl) sortEl.addEventListener('change', function(e){
    state.sort = e.target.value;
    render();
  });

  if (chipWrap) chipWrap.addEventListener('click', function(e){
    var btn = e.target.closest('.chip');
    if (!btn) return;
    chipWrap.querySelectorAll('.chip').forEach(function(c){ c.classList.remove('is-active'); });
    btn.classList.add('is-active');
    state.role = btn.dataset.role || 'all';
    render();
  });

  render();
})();
</script>
