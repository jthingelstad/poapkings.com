---
permalink: /roster/
layout: base.njk
title: Roster | POAP KINGS | A Clash Royale Clan with Proof
description: "POAP KINGS roster — current clan members, roles, trophies, career wins, years played, and collection score. Sort by any column."
navActive: roster
supercellDisclaimer: true
extraScripts: '<script src="/roster.js" defer></script>'
---
{% from "components.njk" import pageIntro, playerTagLink %}
{%- set rows = roster.members | sortByDesc('trophies') -%}
{%- set memberCount = roster.members | length -%}

<div class="pk-page pk-page-shell">
  {{ pageIntro('The people', 'The Roster', memberCount + ' members strong. Sort by any column. Want the trends and distributions? <a href="/data/">Explore the data →</a>') }}

  <div class="pk-roster-toolbar">
    <span class="pk-roster-toolbar__label">Sort by</span>
    {%- set sortOptions = [
      { key: 'trophies', label: 'Trophies' },
      { key: 'wins', label: 'Career Wins' },
      { key: 'years', label: 'Years' },
      { key: 'collection', label: 'Collection' },
      { key: 'donations', label: 'Donations' }
    ] -%}
    {%- for o in sortOptions %}
    <button type="button" class="pk-pill{% if o.key == 'trophies' %} is-active{% endif %}" data-roster-sort="{{ o.key }}">{{ o.label }}</button>
    {%- endfor %}
    <span class="pk-roster-toolbar__status">↻ Updated {{ roster.updated | formatDate }} · showing all {{ memberCount }}</span>
  </div>

  <div class="pk-roster-table">
    <div class="pk-roster-head">
      <span>#</span><span>Player</span><span class="pk-roster-cell--right">Trophies</span><span class="pk-col-opt pk-roster-cell--right">Career Wins</span><span class="pk-col-opt pk-roster-cell--right">Years</span><span class="pk-col-opt pk-roster-cell--right">Collection</span>
    </div>
    <div id="rosterBody">
      {%- for m in rows %}
      <div class="pk-roster-row" id="member-{{ m.tag | memberSlug }}" data-trophies="{{ m.trophies }}" data-wins="{{ m.cr_battle_wins }}" data-years="{{ m.cr_account_age_years }}" data-collection="{{ m.cr_collection_level }}" data-donations="{{ m.donations }}">
        <span class="pk-roster-rank" data-roster-rank>{{ loop.index }}</span>
        <span class="pk-roster-player">
          <strong class="pk-roster-player__name">{{ m.name }}</strong>
          <span class="pk-roster-player__meta">
            <em class="pk-roster-player__role {{ m.role | roleClass }}">{{ m.role }}</em>
            {{ playerTagLink(m.tag, 'pk-roster-player__tag') }}
          </span>
        </span>
        <strong class="pk-roster-trophies">{{ m.trophies | formatNumber }}</strong>
        <span class="pk-col-opt pk-roster-value">{{ m.cr_battle_wins | formatNumber }}</span>
        <span class="pk-col-opt pk-roster-value">{{ m.cr_account_age_years }}y</span>
        <span class="pk-col-opt pk-roster-value">{{ m.cr_collection_level | formatNumber }}</span>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
