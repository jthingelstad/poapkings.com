---
permalink: /roster/
layout: base.njk
title: Roster | POAP KINGS | A Clash Royale Clan with Proof
description: "POAP KINGS roster — current clan members and profile links."
navActive: roster
appJs: true
---
    <section class="pageIntro card">
      <h1 class="pageTitle">Meet the Members</h1>
      <p class="sectionDesc">
        The full roster of royalty, pushing together since February 4, 2026.
        Each member links to <a href="https://royaleapi.com" target="_blank" rel="noreferrer">RoyaleAPI</a>, and those with POAPs can show off their collection.
      </p>
      <div class="ctaRow mt-sm">
        <a class="btn btnPrimary" href="{{ site.joinUrl }}" target="_blank" rel="noreferrer" data-tinylytics-event="roster.join">Join the clan</a>
        <a class="btn btnGhost" href="/faq" data-tinylytics-event="roster.read-faq">Read the FAQ</a>
      </div>
    </section>

    <section>
      <div class="clanStatsGrid">
        {% include "clan-stats.njk" %}
      </div>
    </section>

    <section>
      <div class="card rosterPageCard">
        <div class="rosterHeaderRow">
          <div>
            <h2 class="sectionTitle m-0">Members</h2>
            <div class="tiny mt-xs">Last updated: {{ elixirRoster.updated | formatLongDate }}</div>
          </div>
          <div id="rosterStatus" class="tiny rosterCount">Showing {{ elixirRoster.members | length }} of {{ elixirRoster.members | length }} member{{ "s" if elixirRoster.members | length != 1 }}</div>
        </div>

        {% if elixirRoster.intro %}
        <p class="sectionDesc m-0 mt-sm mb-sm">{{ elixirRoster.intro | md | safe }}</p>
        {% endif %}

        <div class="rosterControls">
          <label class="rosterControl">
            <span>Search</span>
            <input id="rosterSearch" type="search" placeholder="Name, tag, role, arena" />
          </label>
          <label class="rosterControl">
            <span>Sort by</span>
            <select id="rosterSort">
              <option value="rank">Clan Rank</option>
              <option value="trophies">Trophies</option>
              <option value="donations">Donations</option>
              <option value="level">Level</option>
              <option value="accountAge">Account Age</option>
              <option value="joined">Date Joined</option>
            </select>
          </label>
          <label class="rosterControl">
            <span>Role</span>
            <select id="rosterRole">
              <option value="">All Roles</option>
              <option value="leader">Leader</option>
              <option value="elder">Elder</option>
              <option value="member">Member</option>
            </select>
          </label>
        </div>

        <div id="rosterGrid" class="rosterCardGrid">
          {% for m in elixirRoster.members | sortByRank %}
          {%- set rawRole = m.role if m.role else "Member" -%}
          {%- set role = "Leader" if rawRole == "Co-Leader" else rawRole -%}
          {%- set rawTag = m.tag | replace("#", "") -%}
          {%- set memberUrl = m.tag | memberProfileUrl -%}
          <div class="memberCard {{ role | cardClass }}"
               data-search="{{ m | searchText | e }}"
               data-trophies="{{ m.trophies }}"
               data-donations="{{ m.donations }}"
               data-level="{{ m.exp_level }}"
               data-account-age="{{ m.cr_account_age_days or 0 }}"
               data-joined="{{ m.date_joined }}"
               data-rank="{{ m.clan_rank }}"
               data-role="{{ role | lower }}">
            <div class="memberCard__header">
              <a class="memberCard__nameLink" href="{{ memberUrl | e }}">
                <span class="memberCard__name">{{ m.name | e }}</span>
              </a>
              <span class="{{ role | roleClass }}">{{ role | e }}</span>
            </div>
            <div class="memberCard__stats">
              <span class="memberCard__stat">Lvl {{ m.exp_level }}</span>
              <span class="memberCard__stat memberCard__stat--highlight">&#x1F3C6; {{ m.trophies | formatNumber }}</span>
              <span class="memberCard__stat">&#x1F381; {{ m.donations | formatNumber }}</span>
            </div>
            <div class="memberCard__meta">
              <span class="memberCard__arena">{{ m.arena | e }}</span>
              {%- if m.date_joined %}
              <span class="memberCard__joined">Joined {{ m.date_joined | formatDate }}<span class="rosterDuration" data-joined="{{ m.date_joined }}"></span></span>
              {%- endif %}
              {%- if m.cr_account_age_days %}
              <span class="memberCard__joined">Account age {{ m.cr_account_age_days | formatAccountAge }}</span>
              {%- endif %}
            </div>
            {% if m.current_deck_cards and m.current_deck_cards.length %}
            <div class="memberCard__cards">
              {% for card in m.current_deck_cards %}
              {%- set thumbImg = card.icon_urls.evolutionMedium if (card.evolution_level and card.icon_urls.evolutionMedium) else card.icon_url -%}
              <span class="memberCard__card"><img src="{{ thumbImg }}" alt="{{ card.name }}" class="memberCard__cardIcon" width="24" height="28" loading="lazy" /><span class="memberCard__cardName">{{ card.name | e }}</span></span>
              {% endfor %}
            </div>
            {% endif %}
            {% if m.highlight %}<span class="highlightPill highlightPill--{{ m.highlight | e }}">{{ m.highlight | e }}</span>{% endif %}
            {% if m.note %}<div class="memberCard__note">{{ m.note | e }}</div>{% endif %}
            <div class="memberCard__footer">
              <a class="memberCard__cta" href="{{ memberUrl | e }}">View full profile</a>
              <div class="memberCard__subtle">Tag #{{ rawTag | e }}</div>
            </div>
            <button class="tinylytics_kudos" data-path="{{ memberUrl | e }}"></button>
          </div>
          {% endfor %}
          <div class="rosterEmpty" id="rosterEmpty" hidden>No members match the current filters.</div>
        </div>

        <div class="rosterJoinCta">
          {% set openSpots = 50 - (elixirRoster.members | length) %}
          {% if openSpots > 0 %}
          <p class="openSpotsText">{{ openSpots }} spot{{ "s" if openSpots != 1 }} open</p>
          {% else %}
          <p class="openSpotsText">Clan is currently full</p>
          {% endif %}
          <a class="btn btnPrimary" href="{{ site.joinUrl }}" target="_blank" rel="noreferrer" data-tinylytics-event="roster.join">Join the clan</a>
        </div>
      </div>
    </section>
