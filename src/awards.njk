---
permalink: /awards/
layout: base.njk
title: Awards | POAP KINGS | A Clash Royale Clan with Proof
description: "POAP KINGS awards — season honors for war champs, donation champs, rookie MVPs, and Iron Kings, plus the clan's POAP collection."
ogImageAlt: "Latest POAP KINGS badge"
navActive: awards
appJs: true
eleventyComputed:
  ogImage: "{{ vault.poaps | newestPoapImage }}"
---
{%- set inlineSeason = awards.featuredSeason or awards.seasons[0] -%}

<section class="section" style="padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(28px, 4vw, 48px);">
  <span class="eyebrow">The record</span>
  <h1 class="h-display h1 mt-4" style="font-size: clamp(40px, 6vw, 68px)">Awards</h1>
  <p class="lede mt-4">
    POAP KINGS honors members in two parallel ways: <strong style="color:#fff">season awards</strong> earned through war and donation play each season, and <strong style="color:#fff">POAPs</strong> — on-chain badges marking seasons, milestones, scrimmages, and other clan moments. Not every POAP has a matching season award, and not every award has a POAP. Both are part of the record.
  </p>
</section>

<hr class="rule" />

{% if inlineSeason %}
<section class="section" id="season">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Season Awards · Season {{ inlineSeason.season_id }}</span>
      <h2 class="h-display h2 mt-3">Most recent season honors</h2>
      <p class="lede mt-3">
        {{ inlineSeason.season_start | formatLongDate }} – {{ inlineSeason.season_end | formatLongDate }}
        {%- if not inlineSeason.byType.war_champ or inlineSeason.byType.war_champ.length == 0 %} · <span class="pill pill--live pill--dot" style="margin-left:6px;vertical-align:middle">Season in progress</span>{% endif %}
      </p>
    </div>
  </div>
</section>

{% for category in inlineSeason.categories %}
<section class="section--tight">
  <div class="cat-head">
    <div>
      <h3 class="h-display">{{ category.label }}</h3>
      <p class="cat-head__desc">{{ category.description }}</p>
    </div>
    <span class="pill {% if category.style == 'podium' %}pill--gold{% else %}pill--purple{% endif %}">Season honor</span>
  </div>

  {% if category.style == "podium" %}
  <ol class="rankbar">
    {% for a in category.awards %}
    <li class="rankbar__row rankbar__row--rank{{ a.rank }}">
      <div class="rankbar__numeral">{% if a.rank < 10 %}0{% endif %}{{ a.rank }}</div>
      <div class="rankbar__body">
        {%- set tierLabel = "Gold" if a.rank == 1 else ("Silver" if a.rank == 2 else ("Bronze" if a.rank == 3 else "Honor")) -%}
        <span class="rankbar__tier">{{ tierLabel }} · {{ category.singular }}</span>
        <a class="rankbar__name" href="/roster/{{ a.player_tag | memberSlug }}/">{{ a.player_name | e }}</a>
        {% if a.metadata.races_participated %}<div class="rankbar__note">{{ a.metadata.races_participated }} race{{ "s" if a.metadata.races_participated != 1 }}{% if a.metadata.avg_fame %} · avg {{ a.metadata.avg_fame | formatNumber }} fame{% endif %}</div>{% endif %}
      </div>
      <div class="rankbar__metric">
        <span class="rankbar__big">{{ a.metric_value | formatNumber }}</span>
        <span class="rankbar__unit">{{ a.metric_unit }}</span>
      </div>
    </li>
    {% endfor %}
  </ol>

  {% elif category.style == "honorRoll" %}
  <ul class="honor-roll">
    {% for a in category.awards %}
    <li>
      <a href="/roster/{{ a.player_tag | memberSlug }}/">
        <span class="honor-roll__eyebrow">{{ category.singular | upper }}</span>
        <span class="honor-roll__name">{{ a.player_name | e }}</span>
        {% if a.metadata.total_battle_days %}<span class="honor-roll__metric">{{ a.metadata.total_battle_days }} battle days</span>{% endif %}
      </a>
    </li>
    {% endfor %}
  </ul>

  {% else %}
  <ul class="honor-roll" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))">
    {% for a in category.awards %}
    <li>
      <a href="/roster/{{ a.player_tag | memberSlug }}/">
        <span class="honor-roll__eyebrow">{{ category.singular | upper }}</span>
        <span class="honor-roll__name">{{ a.player_name | e }}</span>
        <span class="honor-roll__metric">{{ a.metric_value | formatNumber }} {{ a.metric_unit }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endfor %}
{% endif %}

{% if awards.seasons.length > 1 %}
<hr class="rule" />
<section class="section" id="other">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Archive</span>
      <h2 class="h-display h2 mt-3">Past seasons</h2>
      <p class="lede mt-3">Browse awards from previous seasons.</p>
    </div>
  </div>

  <ul class="seasons-list">
    {% for season in awards.seasons %}
    {% if season.season_id != inlineSeason.season_id %}
    <li>
      <a href="/awards/s{{ season.season_id }}/">
        <div class="seasons-list__head">
          <span class="seasons-list__id">Season {{ season.season_id }}</span>
          <span class="pill">{{ season.awardCount }} award{{ "s" if season.awardCount != 1 }}</span>
        </div>
        <div class="seasons-list__meta">{{ season.season_start | formatDate }} – {{ season.season_end | formatDate }}</div>
        {% if season.byType.war_champ and season.byType.war_champ.length %}
        <div class="seasons-list__champs">War Champs: {% for a in season.byType.war_champ %}<strong>{{ a.player_name | e }}</strong>{% if not loop.last %}, {% endif %}{% endfor %}</div>
        {% endif %}
      </a>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</section>
{% endif %}

<hr class="rule" />

<section class="section" id="vault">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">The Vault</span>
      <h2 class="h-display h2 mt-3">POAPs</h2>
      <p class="lede mt-3">On-chain badges commemorating seasons, milestones, scrimmages, and events. Separate from season awards — some have a matching award, many stand on their own.</p>
      <div class="kicker mt-3" style="color:var(--text-3)">Last updated {{ vault.updated | formatLongDate }}</div>
      <div id="vaultFilterInfo" class="kicker mt-3" hidden style="color:var(--text-3)">
        <span id="vaultFilterDesc"></span>
        <a href="/awards/" id="vaultFilterClear">Show all</a>
      </div>
    </div>
    <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
      <label class="rosterControl" style="min-width:160px;">
        <span>Type</span>
        <select id="vaultTypeFilter">
          <option value="">All types</option>
          <option value="Season">Season</option>
          <option value="Milestone">Milestone</option>
          <option value="Member">Member</option>
          <option value="Event">Event</option>
        </select>
      </label>
      <a class="btn btn--purple btn--sm" href="https://collections.poap.xyz/organizations/poap-kings" target="_blank" rel="noreferrer" data-tinylytics-event="awards.view-poap-xyz">View on POAP.xyz →</a>
    </div>
  </div>

  <div id="vaultStatus" class="kicker mb-sm" style="color:var(--text-3)">Showing {{ vault.poaps | length }} of {{ vault.poaps | length }} POAP{{ "s" if vault.poaps | length != 1 }}</div>

  <div id="vaultGrid" class="vault-grid">
    {% for p in vault.poaps | sortVault %}
    {%- set eventUrl = ("https://poap.gallery/event/" + p.event_id) if p.event_id else "" -%}
    {%- if eventUrl -%}
    <a class="vault{% if p.upcoming %} vault--upcoming{% endif %}" href="{{ eventUrl | e }}" target="_blank" rel="noreferrer" data-type="{{ p.type | lower if p.type else '' }}">
    {%- else -%}
    <div class="vault{% if p.upcoming %} vault--upcoming{% endif %}" data-type="{{ p.type | lower if p.type else '' }}">
    {%- endif %}
      <div class="vault__img">
        {% if p.image %}<img src="{{ p.image | e }}" alt="{{ (p.name or 'POAP') | e }}" loading="lazy" />{% else %}<div style="font-size:48px;opacity:.5">★</div>{% endif %}
      </div>
      <div class="vault__body">
        <span class="{{ p.type | typeClass }}">{{ (p.type or 'POAP') | e }}</span>
        <div class="vault__name">{{ (p.name or 'Untitled POAP') | e }}</div>
        {% if p.date %}<div class="vault__date">{{ p.date | formatDate }}</div>{% endif %}
        {% if p.description %}<p class="vault__desc">{{ p.description | e }}</p>{% endif %}
        {% if p.progress %}
        {% if p.progress.type == "date" %}
        <div class="progressWrap" data-progress="date" data-start="{{ p.progress.start }}" data-end="{{ p.progress.end }}">
          <div class="progressTrack"><div class="progressFill"></div></div>
          <div class="progressLabel"></div>
        </div>
        {% elif p.progress.type == "members" %}
        {% set current = elixirRoster.members | length %}
        {% set target = p.progress.target %}
        {% set pct = (current / target * 100) %}
        <div class="progressWrap">
          <div class="progressTrack"><div class="progressFill" style="width:{{ (pct | round) if pct <= 100 else 100 }}%"></div></div>
          <div class="progressLabel">{% if current >= target %}Unlocked{% else %}{{ current }}/{{ target }}{% endif %}</div>
        </div>
        {% elif p.progress.type == "clan_trophies" %}
        {% set current = elixirClan.clanWarTrophies or 0 %}
        {% set target = p.progress.target %}
        {% set pct = (current / target * 100) %}
        <div class="progressWrap">
          <div class="progressTrack"><div class="progressFill" style="width:{{ (pct | round) if pct <= 100 else 100 }}%"></div></div>
          <div class="progressLabel">{% if current >= target %}Unlocked{% else %}{{ current | formatNumber }}/{{ target | formatNumber }}{% endif %}</div>
        </div>
        {% endif %}
        {% endif %}
      </div>
    {%- if eventUrl %}</a>{%- else %}</div>{%- endif %}
    {% endfor %}
  </div>
  <div class="vaultEmpty mt-sm" id="vaultEmpty" hidden>No POAPs match the current filter.</div>
</section>
