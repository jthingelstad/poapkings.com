---
permalink: /data/
layout: base.njk
title: Clan Data | POAP KINGS | A Clash Royale Clan with Proof
description: "Explore POAP KINGS Clash Royale API data — plot the roster on any two metrics and scrub the clan's whole history. Refreshed daily."
navActive: data
supercellDisclaimer: true
extraScripts: '<script src="/data.js" defer></script>'
---
{% from "components.njk" import pageIntro, sectionHeading %}
{%- set memberCount = clan.memberCount -%}
<script id="explorerData" type="application/json">{{ rosterExplorer.members | explorerMembers | jsonForScript | safe }}</script>
<script id="timelineData" type="application/json">{{ clanTrends.series | timelineSeries | jsonForScript | safe }}</script>

<div class="pk-page pk-page-shell">
  {{ pageIntro('Proof by numbers', 'Clan Data', 'The same Clash Royale API data serious players care about — refreshed daily and fully explorable. Plot the roster on any two metrics, then scrub the clan\'s whole history.') }}

  <!-- Roster Explorer -->
  <section class="pk-data-panel pk-data-panel--first">
    {{ sectionHeading('Interactive', 'Roster Explorer', '<span id="shownCount">' + memberCount + '</span> members plotted · each dot is a player', 'pk-section-heading--gold pk-section-heading--data') }}

    <div class="pk-explorer-controls">
      {%- set metricOpts = [
        { val: 'trophies', label: 'Trophies' },
        { val: 'wins', label: 'Career Wins' },
        { val: 'years', label: 'Years Played' },
        { val: 'collection', label: 'Collection' },
        { val: 'donations', label: 'Donations/wk' }
      ] -%}
      {%- set axisGroups = [
        { group: 'xKey', title: 'X axis', active: 'collection' },
        { group: 'yKey', title: 'Y axis', active: 'trophies' },
        { group: 'sizeKey', title: 'Dot size', active: 'wins' }
      ] -%}
      {%- for g in axisGroups %}
      <div>
        <span class="pk-control-label">{{ g.title }}</span>
        <div class="pk-control-row" data-explorer-group="{{ g.group }}">
          {%- for o in metricOpts %}
          <button type="button" class="pk-pill{% if o.val == g.active %} is-active{% endif %}" data-val="{{ o.val }}">{{ o.label }}</button>
          {%- endfor %}
        </div>
      </div>
      {%- endfor %}
      <div>
        <span class="pk-control-label">Color</span>
        <div class="pk-control-row" data-explorer-group="colorMode">
          <button type="button" class="pk-pill is-active" data-val="role">Role</button>
          <button type="button" class="pk-pill" data-val="value">By Y-value</button>
        </div>
      </div>
    </div>
    <div class="pk-control-row pk-control-row--spaced">
      <span class="pk-control-label pk-control-label--inline">Show</span>
      <div class="pk-control-row" data-explorer-group="roleFilter">
        <button type="button" class="pk-pill is-active" data-val="all">All</button>
        <button type="button" class="pk-pill" data-val="lead">Leadership</button>
        <button type="button" class="pk-pill" data-val="elder">Elders</button>
        <button type="button" class="pk-pill" data-val="member">Members</button>
      </div>
    </div>

    <div class="pk-explorer-chart">
      <div class="pk-chart-frame">
        <svg class="pk-chart-svg" viewBox="0 0 760 420" role="img" aria-label="Scatter plot of clan members">
          <line x1="70" y1="372" x2="724" y2="372" stroke="rgba(215,200,255,.2)" stroke-width="1"></line>
          <line x1="70" y1="32" x2="70" y2="372" stroke="rgba(215,200,255,.2)" stroke-width="1"></line>
          <line id="xMedLine" x1="70" y1="32" x2="70" y2="372" stroke="rgba(245,200,76,.28)" stroke-width="1" stroke-dasharray="4 5"></line>
          <line id="yMedLine" x1="70" y1="372" x2="724" y2="372" stroke="rgba(245,200,76,.28)" stroke-width="1" stroke-dasharray="4 5"></line>
          <text id="xMedLabel" x="70" y="28" text-anchor="middle" fill="rgba(245,200,76,.7)" font-size="10" font-family="Inter,sans-serif" font-weight="700">median</text>
          <text id="xMinL" x="70" y="392" fill="#8a83a6" font-size="12" font-family="Inter,sans-serif"></text>
          <text id="xMaxL" x="724" y="392" text-anchor="end" fill="#8a83a6" font-size="12" font-family="Inter,sans-serif"></text>
          <text id="yMinL" x="62" y="376" text-anchor="end" fill="#8a83a6" font-size="12" font-family="Inter,sans-serif"></text>
          <text id="yMaxL" x="62" y="40" text-anchor="end" fill="#8a83a6" font-size="12" font-family="Inter,sans-serif"></text>
          <text id="xAxisLabel" x="397" y="412" text-anchor="middle" fill="#d7c8ff" font-size="13" font-family="Inter,sans-serif" font-weight="700"></text>
          <text id="yAxisLabel" x="20" y="202" text-anchor="middle" fill="#d7c8ff" font-size="13" font-family="Inter,sans-serif" font-weight="700" transform="rotate(-90 20 202)"></text>
          <g id="scatterDots"></g>
        </svg>
      </div>
      <aside class="pk-detail-panel">
        <span class="pk-detail-panel__kicker" id="detailKicker"></span>
        <strong class="pk-detail-panel__name" id="detailName"></strong>
        <em class="pk-detail-panel__role" id="detailRole"></em>
        <div class="pk-detail-panel__stats" id="detailStats"></div>
        <p class="pk-detail-panel__help">Hover any dot to inspect that member. Dashed gold lines mark the clan median.</p>
      </aside>
    </div>
  </section>

  <!-- Clan timeline -->
  <section class="pk-data-panel">
    {{ sectionHeading('Hover to inspect any day', 'Clan timeline', 'as of <span id="timelineDate"></span>', 'pk-section-heading--gold pk-section-heading--data') }}

    <div class="pk-timeline-chips" id="timelineChips">
      {%- set tMetrics = [
        { key: 'clanScore', label: 'Clan trophies', on: true },
        { key: 'members', label: 'Clan members', on: true },
        { key: 'war', label: 'War trophies', on: false },
        { key: 'donations', label: 'Donations/wk', on: false }
      ] -%}
      {%- for c in tMetrics %}
      <button type="button" class="pk-chip pk-series--{{ c.key }}{% if c.on %} is-active{% endif %}" data-series="{{ c.key }}"><i class="pk-chip__dot"></i>{{ c.label }}</button>
      {%- endfor %}
    </div>

    <div class="pk-timeline-counters" id="timelineCounters"></div>

    <svg class="pk-chart-svg pk-chart-svg--spaced" viewBox="0 0 760 280" role="img" aria-label="Selected clan metrics over time">
      <line x1="60" y1="250" x2="736" y2="250" stroke="rgba(215,200,255,.18)" stroke-width="1"></line>
      <line id="timelineHead" x1="736" y1="24" x2="736" y2="250" stroke="rgba(245,200,76,.4)" stroke-width="1"></line>
      <g id="timelineLines"></g>
      <rect class="pk-timeline-hover" id="timelineHover" x="60" y="24" width="676" height="226" fill="transparent"></rect>
    </svg>
    <div class="pk-chart-legend" id="timelineLegend"></div>
    <p class="pk-chart-note">Hover the chart to read any day; each line is scaled to its own range so trends read clearly side by side.</p>
  </section>
</div>
