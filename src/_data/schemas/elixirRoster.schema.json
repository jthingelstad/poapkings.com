{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["updated", "members"],
  "properties": {
    "updated": { "type": "string" },
    "intro": { "type": "string" },
    "card_stats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "icon_url": { "type": "string" },
          "member_count": { "type": "integer" },
          "avg_pct": { "type": "integer" },
          "members": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "tag", "role"],
        "properties": {
          "name": { "type": "string" },
          "tag": { "type": "string" },
          "role": { "type": "string" },
          "exp_level": { "type": "integer" },
          "trophies": { "type": "integer" },
          "arena": { "type": "string" },
          "clan_rank": { "type": "integer" },
          "donations": { "type": "integer" },
          "donations_received": { "type": "integer" },
          "last_seen": { "type": "string" },
          "note": { "type": "string" },
          "profile_url": { "type": "string" },
          "poap_address": { "type": "string" },
          "date_joined": { "type": "string" },
          "bio": { "type": "string" },
          "highlight": { "type": "string", "enum": ["donations", "war", "trophies", "tenure", "general"] },
          "favorite_cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "icon_url": { "type": "string" },
                "usage_pct": { "type": "integer" }
              }
            }
          },
          "current_deck": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
