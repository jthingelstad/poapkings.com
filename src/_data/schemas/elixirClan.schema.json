{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["memberCount", "clanScore", "clanWarTrophies", "donationsPerWeek"],
  "properties": {
    "memberCount": { "type": "integer" },
    "clanScore": { "type": "integer" },
    "clanWarTrophies": { "type": "integer" },
    "donationsPerWeek": { "type": "integer" },
    "totalTrophies": { "type": "integer" },
    "avgLevel": { "type": "number" },
    "minTrophies": { "type": "integer" },
    "clanLeague": { "type": "string" },
    "clanStatus": { "type": "string" }
  }
}
