{%- macro faqSection(id, heading, items) -%}
  <h2 id="{{ id }}" style="font-family:'Supercell Magic',system-ui,sans-serif;font-size:1.3rem;margin:38px 0 12px;scroll-margin-top:80px;">{{ heading | safe }}</h2>
  {%- for f in items %}
  <div style="margin-bottom:22px;">
    <h3 style="margin:0 0 8px;font-weight:700;font-size:1.02rem;color:#f7f4ff;">{{ f.q }}</h3>
    <p style="color:#c8c1e6;line-height:1.65;margin:0;">{{ f.a }}</p>
  </div>
  {%- endfor %}
{%- endmacro -%}

{%- set faqAbout = [
  { q: 'Why did you create POAP KINGS?', a: "Raquaza and King Levy have played Clash Royale for over three years, cycling through clans that never quite fit. King Thing picked it up more recently. We're all family, so we built the clan we wanted: structure, recognition, and something lasting to show for the grind." },
  { q: 'Why the name POAP KINGS?', a: 'For us, POAP means "Proof of Arena Push" — the grind is real, so show the receipts. Kings because we aim high. It\'s become the whole identity of the clan: prove it, then prove it again.' }
] -%}
{%- set faqJoining = [
  { q: 'How do I join?', a: "We're currently invite only. Search POAP KINGS or use tag #J2RGCRVG in Clash Royale. Minimum 7,000 trophies. Apply in-game and leadership will review it." },
  { q: 'What are the clan rules?', a: 'Be active (don\'t ghost a whole season without a heads-up), be generous (donate when you can), be decent (no toxicity or drama), and take part in wars when you can. Real life comes first — just communicate.' },
  { q: 'Can I have an alt account in the clan?', a: 'Yes — one alt per player, as long as you proactively tell leadership which account is your alt. Hidden alts can get both accounts kicked, and if the clan is near capacity, alts may be removed even when active.' }
] -%}
{%- set faqWars = [
  { q: 'Do I have to participate in Clan Wars?', a: 'No — encouraged but not required. Consistent participation and good vibes matter more than strict requirements. That said, war performance is how you earn War Champ and Free Pass Royale eligibility.' },
  { q: 'How is War Champ chosen?', a: 'Top Clan Wars point earner for the season, pulled directly from the Clash Royale API — no manual adjustments. Joining mid-season doesn\'t earn a handicap. Leadership breaks ties transparently.' }
] -%}
{%- set faqPass = [
  { q: 'What is the Free Pass Royale Program?', a: 'The top eligible war point earner each season gets a free Pass Royale, sent in-game. Real reward, no gimmicks.' },
  { q: 'How does eligibility work?', a: 'Highest war points among eligible players for the season. No back-to-back winners. Alt accounts can win, but eligibility follows the player. Points come straight from the Clash Royale API.' },
  { q: 'How will I receive the pass?', a: 'Sent in-game to the account playing in the clan — no PayPal, Venmo, or cash. You must be Supercell ID friends with King Thing (Thingles) beforehand. Set that up on the Setup page so there are no delays when you win.' }
] -%}
{%- set faqRoles = [
  { q: 'What are the roles?', a: 'Member (standard participant), Elder (earned by competing for the clan and donating generously — it can also be taken away), and Leadership (Co-Leaders and the Leader, appointed at leadership\'s discretion).' },
  { q: 'How do I earn Elder?', a: 'Three things: about four weeks in the clan, competing for the clan (play Clan Wars or Ranked — Wars counts most), and donating generously relative to clanmates. Elders make up roughly 15–20% of the clan; the bar is the clan itself, not a fixed number.' },
  { q: 'How are promotions handled?', a: 'Leadership reviews promotions and demotions each Tuesday, and Elixir shares a transparent weekly Elder Standing so everyone can see where they stand. Elder is the only role earned this way — please don\'t request a promotion.' }
] -%}
{%- set faqDiscord = [
  { q: 'Do I need to join the Discord to be in the clan?', a: "No, but it's highly encouraged — it's where announcements and war coordination happen, so you won't miss anything. Please set your server nickname to your Clash Royale player name. Not on Discord? Use the email signup on the Members page instead." },
  { q: 'What happens on the Discord server?', a: 'Announcements, clan promotion, deck and matchup talk, war coordination, and general chat. It\'s where the clan lives beyond in-game chat.' }
] -%}

