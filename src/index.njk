---
layout: base.njk
title: POAP KINGS | A Clash Royale Clan with Proof
description: "POAP KINGS — a Clash Royale clan celebrating seasons, generosity, and Proof of Arena Push."
navActive: home
mainId: top
supercellDisclaimer: true
ogImage: /assets/poapkings.png
ogImageAlt: POAP KINGS crest
ogImageWidth: 1200
ogImageHeight: 1200
---
{%- set isFull = clan.memberCount >= 50 -%}
{%- set insightStats = clanInsights.headlineStats or [] -%}
{%- set trophyLeaders = clanInsights.leaders.trophies or [] -%}

<section class="section" data-section="hero" style="padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(36px, 5vw, 60px);">
  <div class="hero-grid">
    <div>
      <span class="eyebrow">CLAN TAG&nbsp;&nbsp;<span class="mono" style="color:var(--text-2);letter-spacing:.04em">#{{ site.clanTag }}</span></span>
      <h1 class="h-display h1 mt-4">POAP<br/>KINGS</h1>
      <p class="lede mt-5">
        A <a href="https://clashroyale.com" target="_blank" rel="noreferrer" style="color:#fff;border-bottom:1px solid var(--hairline-2)">Clash Royale</a> clan built around active, positive gameplay — and something a little different.
        We collect <strong style="color:#fff">POAPs</strong> as proof of participation and shared clan history.
        Good vibes, real rewards, zero drama.
      </p>
      <div class="ctaRow mt-6">
        {% if isFull %}
        <button type="button" class="btn btn--purple" data-modal-open="join" data-tinylytics-event="home.waitlist">WAIT</button>
        <a href="/roster" class="btn btn--ghost" data-tinylytics-event="home.see-roster">See the roster</a>
        {% else %}
        <button type="button" class="btn btn--gold" data-modal-open="join" data-tinylytics-event="home.join">JOIN</button>
        <a href="/roster" class="btn btn--ghost" data-tinylytics-event="home.see-roster">See the roster</a>
        {% endif %}
      </div>
      <div class="mt-5" style="color:var(--text-3);font-size:13px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span class="kicker" style="color:var(--text-2)">Different flags. Same grind.</span>
        <span class="tinylytics_countries" style="font-size:20px;letter-spacing:3px"></span>
      </div>
    </div>

    <div class="hero-proof">
      <div class="hero-proof__head">
        <img src="/assets/poapkings.png" alt="" />
        <div>
          <span class="kicker">Roster snapshot</span>
          <strong>{{ roster.updated | formatDate }}</strong>
        </div>
      </div>
      <div class="hero-proof__stats">
        {% for stat in insightStats %}
        <div>
          <span>{{ stat.label }}</span>
          <strong>{{ stat.value | formatNumber }}</strong>
          <small>{{ stat.detail }}</small>
        </div>
        {% endfor %}
      </div>
      <div class="hero-proof__bars" aria-label="Trophy distribution">
        {% for bucket in clanInsights.trophyDistribution %}
        <div class="hero-proof__bar">
          <span>{{ bucket.label }}</span>
          <div><i style="width: {{ (bucket.count / clan.memberCount * 100) if clan.memberCount else 0 }}%"></i></div>
          <strong>{{ bucket.count }}</strong>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section--tight" data-section="trophy-strip" style="padding-top: 0;">
  <div class="trophystrip">
    <div class="trophystrip__cell">
      <div class="trophystrip__n" data-count-up="{{ clan.clanScore }}" data-count-up-ms="1600">0</div>
      <div class="trophystrip__label">Clan Trophies</div>
    </div>
    <div class="trophystrip__cell{% if isFull %} trophystrip__cell--full{% endif %}">
      <div class="trophystrip__n"><span data-count-up="{{ clan.memberCount }}">0</span> / 50</div>
      <div class="trophystrip__label">{% if isFull %}Clan full · waitlist{% else %}Members{% endif %}</div>
    </div>
    <div class="trophystrip__cell">
      <div class="trophystrip__n">{{ clan.clanWarTrophies | cwlTier }}</div>
      <div class="trophystrip__label">War League · {{ clan.clanWarTrophies | formatNumber }} trophies</div>
    </div>
    <div class="trophystrip__cell">
      <div class="trophystrip__n"><span data-count-up="{{ clan.minTrophies }}">0</span>+</div>
      <div class="trophystrip__label">Min Trophies</div>
    </div>
  </div>
</section>

<section class="section" data-section="proof">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Proof by numbers</span>
      <h2 class="h-display h2 mt-3">A veteran roster, visible at a glance.</h2>
      <p class="lede mt-3">The website now publishes the same kind of Clash Royale API data players care about: trophy depth, career wins, collection score, account tenure, and Clan Wars history.</p>
    </div>
    <a href="/wars/" class="btn--link">Clan Wars history →</a>
  </div>

  <div class="data-grid data-grid--home">
    <article class="data-panel data-panel--wide">
      <div class="data-panel__head">
        <div>
          <span class="kicker">Historical roster strength</span>
          <h3 class="h-display h3">Daily clan trend</h3>
        </div>
        <span>{{ clanTrends.firstDate | formatDate }} – {{ clanTrends.latestDate | formatDate }}</span>
      </div>
      <svg class="line-chart" id="homeTrendChart" viewBox="0 0 720 260" role="img" aria-label="Clan score and top-player trend over time"></svg>
      <div class="chart-legend">
        <span><i class="legend-dot legend-dot--gold"></i> Clan score</span>
        <span><i class="legend-dot legend-dot--cyan"></i> 12k+ members</span>
      </div>
    </article>

    <article class="data-panel">
      <div class="data-panel__head">
        <div>
          <span class="kicker">Current roster</span>
          <h3 class="h-display h3">Trophy depth</h3>
        </div>
      </div>
      <div class="distribution">
        {% for bucket in clanInsights.trophyDistribution %}
        <div class="distribution__row">
          <span>{{ bucket.label }}</span>
          <div><i style="width: {{ (bucket.count / clan.memberCount * 100) if clan.memberCount else 0 }}%"></i></div>
          <strong>{{ bucket.count }}</strong>
        </div>
        {% endfor %}
      </div>
    </article>

    <article class="data-panel">
      <div class="data-panel__head">
        <div>
          <span class="kicker">Top ladder players</span>
          <h3 class="h-display h3">Current leaders</h3>
        </div>
      </div>
      <ol class="leader-list">
        {% for leader in trophyLeaders | take(6) %}
        <li>
          <span>{{ leader.name }}</span>
          <strong>{{ leader.value | formatNumber }}</strong>
        </li>
        {% endfor %}
      </ol>
    </article>
  </div>
</section>

<script id="homeTrendData" type="application/json">{{ clanTrends.series | dump | safe }}</script>
<script>
(function(){
  var el = document.getElementById('homeTrendChart');
  var dataEl = document.getElementById('homeTrendData');
  if (!el || !dataEl) return;
  var rows = JSON.parse(dataEl.textContent || '[]').filter(function(row){
    return row.clanScore != null && row.count12000Plus != null;
  });
  if (rows.length < 2) return;

  function extent(key){
    var values = rows.map(function(row){ return Number(row[key]); }).filter(Number.isFinite);
    return [Math.min.apply(Math, values), Math.max.apply(Math, values)];
  }
  function points(key, min, max){
    var span = max - min || 1;
    return rows.map(function(row, index){
      var x = 44 + (index / Math.max(1, rows.length - 1)) * 632;
      var y = 218 - ((Number(row[key]) - min) / span) * 170;
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');
  }
  function node(name, attrs){
    var item = document.createElementNS('http://www.w3.org/2000/svg', name);
    Object.keys(attrs).forEach(function(key){ item.setAttribute(key, attrs[key]); });
    return item;
  }

  var score = extent('clanScore');
  var elite = extent('count12000Plus');
  el.appendChild(node('line', { x1: 44, y1: 218, x2: 676, y2: 218, class: 'chart-axis' }));
  el.appendChild(node('line', { x1: 44, y1: 48, x2: 44, y2: 218, class: 'chart-axis' }));
  el.appendChild(node('polyline', { points: points('clanScore', score[0], score[1]), class: 'chart-line chart-line--gold' }));
  el.appendChild(node('polyline', { points: points('count12000Plus', elite[0], elite[1]), class: 'chart-line chart-line--cyan' }));
})();
</script>

<section class="section" data-section="why">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Why join</span>
      <h2 class="h-display h2 mt-3">Not just another clan</h2>
      <p class="lede mt-3">A place for players who enjoy progression, community, and being part of something from the beginning.</p>
    </div>
  </div>

  <ol class="reasons">
    <li class="reason">
      <div class="reason__num">01</div>
      <h3 class="h-display h3">Collect unique POAPs</h3>
      <p>Members collect on-chain badges tied to seasons, milestones and events. Your proof of Arena Push, season by season.</p>
    </li>
    <li class="reason">
      <div class="reason__num">02</div>
      <h3 class="h-display h3">Compete for real rewards</h3>
      <p>Strong Clan Wars contribution keeps eligible members in the running for clan-funded Pass Royale rewards.</p>
    </li>
    <li class="reason">
      <div class="reason__num">03</div>
      <h3 class="h-display h3">Good vibes only</h3>
      <p>War participation is encouraged but not required. No pressure, no spreadsheets — real life comes first.</p>
    </li>
    <li class="reason">
      <div class="reason__num">04</div>
      <h3 class="h-display h3">Generosity is the flex</h3>
      <p>Elders donate regularly. Help your clanmates, earn your title, and watch the donation totals climb.</p>
    </li>
    <li class="reason">
      <div class="reason__num">05</div>
      <h3 class="h-display h3">Active community</h3>
      <p>Active members expected. Idle accounts are removed to keep the clan healthy and donations flowing.</p>
    </li>
    <li class="reason">
      <div class="reason__num">06</div>
      <h3 class="h-display h3">Discord community</h3>
      <p>Deck advice, matchup banter, Sunday Scrimmages, and the occasional meme. The clan lives beyond the game.</p>
    </li>
  </ol>
</section>

<hr class="rule" />

<section class="section" data-section="how">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow eyebrow--purple">How it works</span>
      <h2 class="h-display h2 mt-3">Simple cadence.<br/>Clear incentives.</h2>
    </div>
  </div>

  <div class="steps">
    <div class="step">
      <div class="step__n">1</div>
      {% if isFull %}
      <h3 class="h-display h3">Join the waitlist</h3>
      <p>We're <strong>full right now</strong> — all 50 seats taken. Drop into our <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" style="color:var(--gold)">Discord</a> so we know you when a spot opens up. Minimum {{ clan.minTrophies | formatNumber }}+ trophies.</p>
      {% else %}
      <h3 class="h-display h3">Join the clan</h3>
      <p>Search for <strong>POAP KINGS</strong> in-game, or use clan tag <span class="mono" style="color:var(--gold)">#{{ site.clanTag }}</span>. We're {{ clan.clanStatus | lower }} to anyone with {{ clan.minTrophies | formatNumber }}+ trophies.</p>
      {% endif %}
    </div>
    <div class="step">
      <div class="step__n">2</div>
      <h3 class="h-display h3">Play &amp; donate</h3>
      <p>Push ladder, join Clan Wars when you can, and donate to your clanmates. That's how you earn Elder.</p>
    </div>
    <div class="step">
      <div class="step__n">3</div>
      <h3 class="h-display h3">Collect the proof</h3>
      <p>Each season, active members receive a POAP — a collectible badge that marks the moment.</p>
    </div>
  </div>
</section>

{% set recentVault = vault.poaps | sortVault | take(5) %}
{% if recentVault and recentVault.length %}
<section class="section" data-section="vault">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">The Vault</span>
      <h2 class="h-display h2 mt-3">Recent drops</h2>
      <p class="lede mt-3">On-chain badges commemorating seasons, milestones, scrimmages and events.</p>
    </div>
    <a href="/vault/" class="btn--link">Browse all POAPs →</a>
  </div>

  <div class="vault-grid">
    {% for p in recentVault %}
    {%- set eventUrl = ("https://poap.gallery/event/" + p.event_id) if p.event_id else "" -%}
    {%- if eventUrl -%}
    <a class="vault" href="{{ eventUrl | e }}" target="_blank" rel="noreferrer">
    {%- else -%}
    <div class="vault">
    {%- endif %}
      <div class="vault__img">
        {% if p.image %}<img src="{{ p.image | e }}" alt="{{ (p.name or 'POAP') | e }}" />{% else %}<div style="font-size:36px;opacity:.5">★</div>{% endif %}
      </div>
      <div class="vault__body">
        <span class="{{ p.type | typeClass }}">{{ (p.type or 'POAP') | e }}</span>
        <div class="vault__name">{{ (p.name or 'Untitled POAP') | e }}</div>
        {% if p.date %}<div class="vault__date">{{ p.date | formatDate }}</div>{% endif %}
      </div>
    {%- if eventUrl %}</a>{%- else %}</div>{%- endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="section" data-section="join">
  <div class="final-join">
    {%- set spotsLeft = 50 - clan.memberCount -%}
    <div>
      <span class="eyebrow">Ready?</span>
      {% if spotsLeft > 0 %}
      <h2 class="h-display h2 mt-3">We're {{ clan.clanStatus | lower }}.<br/>{{ spotsLeft }} spot{{ "s" if spotsLeft != 1 }} left.</h2>
      <p class="lede mt-4">If you've got {{ clan.minTrophies | formatNumber }}+ trophies, you can jump in right now. See you in Discord.</p>
      {% else %}
      <h2 class="h-display h2 mt-3">The clan<br/>is full.</h2>
      <p class="lede mt-4">All 50 seats are taken for now — but roster turns over every season. Drop into Discord so we know you when a spot opens up.</p>
      {% endif %}
    </div>
    <div class="final-join__side">
      <dl class="final-join__dl">
        <div><dt>Clan Name</dt><dd>POAP KINGS</dd></div>
        <div><dt>Clan Tag</dt><dd class="mono">#{{ site.clanTag }}</dd></div>
        <div><dt>Region</dt><dd>{{ clan.clanRegion }}</dd></div>
        <div><dt>Type</dt><dd>{{ clan.clanStatus }}</dd></div>
      </dl>
      <div class="ctaRow mt-5">
        {% if isFull %}
        <button type="button" class="btn btn--purple" data-modal-open="join" data-tinylytics-event="home.final-waitlist">WAIT</button>
        <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" class="btn btn--ghost" data-tinylytics-event="home.final-discord">Open Discord</a>
        {% else %}
        <button type="button" class="btn btn--gold" data-modal-open="join" data-tinylytics-event="home.final-join">JOIN</button>
        <a href="/members/setup/" class="btn btn--ghost" data-tinylytics-event="home.clan-setup">Clan setup</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
