---
layout: base.njk
title: POAP KINGS | A Clash Royale Clan with Proof
description: "POAP KINGS — a Clash Royale clan built on active, positive play and a roster deep enough to prove it. We publish our data so serious players can see who they're joining."
navActive: home
mainId: top
supercellDisclaimer: true
ogImage: /assets/poapkings.png
ogImageAlt: POAP KINGS crest
ogImageWidth: 1004
ogImageHeight: 1000
---
{% from "components.njk" import sectionHeading, actionLink, actionButton, playerTagLink %}
{%- set members = rosterExplorer.members -%}
{%- set memberCount = clan.memberCount -%}
{%- set openSlots = 50 - memberCount -%}
{%- set totalWins = members | sumBy('wins') -%}
{%- set avgWins = (totalWins / memberCount) | round -%}
{%- set avgTrophies = (clan.totalTrophies / memberCount) | round -%}
{%- set elders = members | whereRole('Elder') | sortByDesc('years') -%}
{%- set scatterPoints = members | homeScatter -%}
{%- set latestRecognition = recognition.seasons[0] -%}

<div class="pk-page">

  <section class="pk-hero pk-home-hero">
    <div>
      <span class="pk-eyebrow">Clan Tag&nbsp;&nbsp;<span class="pk-mono-gold">#{{ site.clanTag }}</span></span>
      <h1 class="pk-home-title">POAP<br>KINGS</h1>
      <p class="pk-home-lede">A <a href="https://clashroyale.com" target="_blank" rel="noreferrer">Clash Royale</a> clan built on active, positive play — and a roster deep enough to prove it. We publish our data so serious players can see exactly who they're joining.</p>
      <div class="pk-home-actions">
        {{ actionLink('/roster/', 'See the roster', 'purple', 'home.see-roster') }}
        {{ actionLink('/data/', 'Explore the data', 'outline', 'home.explore-data') }}
      </div>
      <p class="pk-home-updated"><span class="pk-home-updated__icon">↻</span> Data updated {{ roster.updated | formatDate }} from the Clash Royale API.</p>
    </div>

    <div class="pk-stat-panel">
      <div class="pk-stat-panel__head">
        <img class="pk-stat-panel__crest" src="/assets/poapkings.png" alt="">
        <div class="pk-stat-panel__label">
          <span class="pk-micro-label">Proof by numbers</span>
          <strong class="pk-stat-panel__title">Roster snapshot</strong>
        </div>
      </div>
      <div class="pk-stat-grid">
        {%- set heroStats = [
          { label: 'Clan Trophies', value: clan.clanScore | formatNumber, detail: 'Across all ' + memberCount + ' members' },
          { label: 'Avg Trophies', value: avgTrophies | formatNumber, detail: (clan.totalTrophies | formatNumber) + ' total' },
          { label: 'Donations / week', value: clan.donationsPerWeek | formatNumber, detail: 'Whole-clan generosity' },
          { label: 'Career Wins', value: totalWins | formatNumber, detail: (avgWins | formatNumber) + ' avg per member' }
        ] -%}
        {%- for s in heroStats %}
        <div class="pk-stat">
          <span class="pk-stat__label">{{ s.label }}</span>
          <strong class="pk-stat__value">{{ s.value }}</strong>
          <small class="pk-stat__detail">{{ s.detail }}</small>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- testimonial -->
  <section class="pk-testimonial">
    <figure class="pk-testimonial__card">
      <blockquote class="pk-testimonial__quote">I've been playing Clash Royale for 10 years and I just want to say this is hands down <span class="pk-testimonial__highlight">THE best clan</span> I've ever been in. Y'all are great!</blockquote>
      <figcaption class="pk-testimonial__caption">
        <div class="pk-testimonial__byline">
          <strong class="pk-testimonial__name">Th15_Guy</strong>
          <span class="pk-testimonial__meta">Elder · 10 years in Clash Royale · {{ playerTagLink('QLGYYG0Q', 'pk-testimonial__tag') }}</span>
        </div>
      </figcaption>
    </figure>
  </section>

  <!-- requirements -->
  <section class="pk-req-wrap pk-requirements">
    <span class="pk-requirements__label">Are you a fit? · Requirements</span>
    <div class="pk-req4">
      {%- set requirements = [
        { label: 'Min Trophies', value: clan.minTrophies | formatNumber },
        { label: 'Clan Status', value: clan.clanStatus },
        { label: 'Open Slots', value: openSlots + ' of 50' },
        { label: 'War League', value: clan.clanWarTrophies | cwlTier }
      ] -%}
      {%- for r in requirements %}
      <div class="pk-requirement">
        <strong class="pk-requirement__value">{{ r.value }}</strong>
        <span class="pk-requirement__label">{{ r.label }}</span>
      </div>
      {%- endfor %}
    </div>
  </section>

  <!-- latest completed season recognition -->
  <section class="pk-home-recognition" aria-labelledby="home-recognition-title">
    <div class="pk-home-recognition__intro">
      <span class="pk-eyebrow pk-eyebrow--gold">Season {{ latestRecognition.seasonId }} · final</span>
      <h2 id="home-recognition-title">The clan remembers who showed up.</h2>
      <p>Recognition is earned from completed season data—not vibes, favorites, or a provisional leaderboard.</p>
      <a href="/recognition/">See every honor and completed season →</a>
    </div>
    <div class="pk-home-recognition__honors">
      <div>
        <span>War Champ</span>
        <strong>{{ latestRecognition.warChamp[0].name }}</strong>
        <small>{{ latestRecognition.warChamp[0].metricValue | formatNumber }} points</small>
      </div>
      <div>
        <span>Iron Kings</span>
        <strong>{% for player in latestRecognition.ironKings %}{{ player.name }}{% if not loop.last %}, {% endif %}{% endfor %}</strong>
        <small>Every deck, every battle day</small>
      </div>
      <div>
        <span>Rookie MVP</span>
        <strong>{{ latestRecognition.rookieMvp[0].name }}</strong>
        <small>{{ latestRecognition.rookieMvp[0].metricValue | formatNumber }} points</small>
      </div>
    </div>
  </section>

  <!-- mini trend + roster teaser -->
  <section class="pk-split">
    <article class="pk-mini-panel">
      <div class="pk-mini-panel__head">
        <div>
          <span class="pk-micro-label">The whole roster, plotted</span>
          <h3 class="pk-mini-panel__title">Collection depth × trophies</h3>
        </div>
        <a class="pk-mini-panel__link" href="/data/">Full data page →</a>
      </div>
      <svg class="pk-mini-chart" viewBox="0 0 720 280" role="img" aria-label="Scatter plot of each clan member by collection level and trophy count">
        <line x1="60" y1="222" x2="700" y2="222" stroke="rgba(215,200,255,.18)" stroke-width="1"></line>
        <line x1="60" y1="24" x2="60" y2="222" stroke="rgba(215,200,255,.18)" stroke-width="1"></line>
        <text x="380" y="262" text-anchor="middle" fill="#8a83a6" font-size="13" font-family="Inter,sans-serif" font-weight="700">Collection level →</text>
        <text x="20" y="123" text-anchor="middle" fill="#8a83a6" font-size="13" font-family="Inter,sans-serif" font-weight="700" transform="rotate(-90 20 123)">Trophies →</text>
        {%- for p in scatterPoints %}
        <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="6" fill="{{ p.fill }}" stroke="rgba(7,6,16,.6)" stroke-width="1.5" opacity="0.9"></circle>
        {%- endfor %}
      </svg>
      <div class="pk-chart-legend">
        <span class="pk-chart-legend__item"><i class="pk-chart-legend__dot pk-chart-legend__dot--lead"></i> Leadership</span>
        <span class="pk-chart-legend__item"><i class="pk-chart-legend__dot pk-chart-legend__dot--elder"></i> Elder</span>
        <span class="pk-chart-legend__item"><i class="pk-chart-legend__dot pk-chart-legend__dot--member"></i> Member</span>
      </div>
    </article>

    <article class="pk-mini-panel">
      <span class="pk-micro-label">The backbone of the clan</span>
      <h3 class="pk-mini-panel__title">Our Elders</h3>
      <p class="pk-mini-panel__copy">Earned through wars, ranked, and generosity.</p>
      <ol class="pk-elder-list">
        {%- for l in elders | take(6) %}
        <li class="pk-elder-list__item">
          <span class="pk-elder-list__name">{{ l.name }}</span>
          <span class="pk-elder-list__years">{{ l.years }}y played</span>
        </li>
        {%- endfor %}
      </ol>
      <a class="pk-mini-panel__link pk-mini-panel__link--spaced" href="/roster/">See full roster →</a>
    </article>
  </section>

  <!-- why join -->
  <section class="pk-section pk-section--spacious">
    {{ sectionHeading('Why join', 'Not just another clan') }}
    <ol class="pk-grid-3 pk-reasons">
      {%- set reasons = [
        { num: '01', title: 'Proof, not hype', body: "Our full roster and clan stats are public and refreshed daily. See exactly who you're joining before you apply — most clans ask you to just trust them." },
        { num: '02', title: 'Structure you can see', body: 'Elder is earned through participation you control — wars, ranked, donations — reviewed every Tuesday, with standings shared openly. No favoritism, no guessing.' },
        { num: '03', title: 'Real, clan-funded rewards', body: 'Each season\'s top war point earner is named War Champ. The highest-ranked eligible player receives a gifted Pass Royale through Supercell ID — an actual reward for showing up, not just a leaderboard badge.' },
        { num: '04', title: 'Generosity is the flex', body: 'Cards donated every week by the whole clan, with Elders leading by example. Post a request and it fills fast — your upgrades never stall waiting on the clan.' },
        { num: '05', title: 'We build our own tools', body: 'Elixir runs recognition, standings, coaching, and the clan\'s weekly story. Elixir Drop, our game, sharpens your play. Almost no clan ships its own software.' },
        { num: '06', title: 'Veteran, drama-free culture', body: 'A veteran roster with real staying power. Wars encouraged, not required — good vibes, and real life always comes first.' }
      ] -%}
      {%- for r in reasons %}
      <li class="pk-reason">
        <div class="pk-reason__number">{{ r.num }}</div>
        <h3 class="pk-reason__title">{{ r.title }}</h3>
        <p class="pk-reason__copy">{{ r.body }}</p>
      </li>
      {%- endfor %}
    </ol>
  </section>

  <!-- built by POAP KINGS -->
  <section class="pk-section pk-section--spacious">
    {{ sectionHeading('Built by POAP KINGS', 'We build our own tools') }}
    <div class="pk-grid-2 pk-tools">
      <a class="pk-tool-card pk-tool-card--elixir" href="/elixir/">
        <div>
          <span class="pk-tool-card__badge">Our clan agent</span>
          <h3 class="pk-tool-card__title">Meet Elixir</h3>
          <p class="pk-tool-card__copy">Built by and for POAP KINGS, Elixir runs the weekly Elder Standing, tracks season recognition, coaches members, and makes sure the clan remembers who showed up.</p>
          <span class="pk-tool-card__cta pk-tool-card__cta--compact">Meet Elixir →</span>
        </div>
      </a>
      <article class="pk-tool-card">
        <div>
          <span class="pk-tool-card__badge">Our game</span>
          <h3 class="pk-tool-card__title">Elixir Drop</h3>
          <p class="pk-tool-card__copy">A free browser trainer that builds instant recall of Clash Royale card elixir costs through six fast game modes.</p>
        </div>
        <div class="pk-tool-card__actions">
          <a class="pk-tool-card__cta" href="/elixir-drop/">Learn more →</a>
          <a class="pk-tool-card__play" href="https://drop.poapkings.com/" target="_blank" rel="noreferrer" data-tinylytics-event="home.elixir-drop-play">Play now ↗</a>
        </div>
      </article>
    </div>
  </section>

  <!-- final join -->
  <section class="pk-split pk-final-join">
    <div>
      <span class="pk-eyebrow">Ready?</span>
      <h2 class="pk-final-join__title">{% if openSlots > 0 %}We're invite only.<br>{{ openSlots }} spot{{ 's' if openSlots != 1 }} left.{% else %}We're invite only.<br>The clan is full.{% endif %}</h2>
      <p class="pk-final-join__copy">If you've got {{ clan.minTrophies | formatNumber }}+ trophies and show up for war, apply in-game and leadership will review it. See you in Discord.</p>
    </div>
    <div>
      <dl class="pk-final-join__facts">
        <div class="pk-final-join__fact"><dt>Clan Tag</dt><dd class="pk-mono-gold">#{{ site.clanTag }}</dd></div>
        <div class="pk-final-join__fact"><dt>Region</dt><dd>{{ clan.clanRegion }}</dd></div>
        <div class="pk-final-join__fact"><dt>Type</dt><dd>{{ clan.clanStatus }}</dd></div>
      </dl>
      <div class="pk-final-join__actions">
        {{ actionButton('JOIN', 'gold', 'join', 'home.join') }}
        {{ actionLink(site.discordUrl, 'Open Discord', 'outline', '', true) }}
      </div>
    </div>
  </section>

</div>
