---
permalink: /members/
layout: base.njk
title: "Members | POAP KINGS | A Clash Royale Clan with Proof"
description: "Members — onboarding and member resources for POAP KINGS."
navActive: members
extraScripts: '<script src="/members-promo.js" defer></script>'
---
<section class="section" style="padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(28px, 4vw, 48px);">
  <span class="eyebrow">Members hub</span>
  <h1 class="h-display h1 mt-4" style="font-size: clamp(40px, 6vw, 68px)">Welcome KING…</h1>
  <p class="lede mt-4">
    Your resource hub for clan news, awards, promotion tools, and site updates. Everything you need as a <strong style="color:#fff">POAP KINGS</strong> member is right here.
  </p>
  <p class="lede mt-4"><strong style="color:#fff">New to the clan?</strong> Get connected with leaders, set up your wallet, and register for the roster.</p>
  <div class="ctaRow mt-5">
    <a class="btn btn--purple" href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" data-tinylytics-event="members.join-discord">Join Discord</a>
    <a class="btn btn--gold" href="/members/setup/" data-tinylytics-event="members.clan-setup">Clan Setup</a>
    <a class="btn btn--ghost" href="/faq" data-tinylytics-event="members.read-faq">Read the FAQ</a>
  </div>
</section>

{% if awards.featuredSeason and awards.featuredSeason.byType.war_champ and awards.featuredSeason.byType.war_champ.length %}
{%- set season = awards.featuredSeason -%}
<hr class="rule" />
<section class="section">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Season {{ season.season_id }} · Award standings</span>
      <h2 class="h-display h2 mt-3">War Champs</h2>
      <p class="lede mt-3">Top three war contributors by total fame earned across the season's races. These members earn a Royal Pass from the clan.</p>
    </div>
    <a class="btn--link" href="/awards" data-tinylytics-event="members.see-all-awards">All awards →</a>
  </div>

  <ol class="rankbar">
    {% for a in season.byType.war_champ %}
    <li class="rankbar__row rankbar__row--rank{{ a.rank }}">
      <div class="rankbar__numeral">{% if a.rank < 10 %}0{% endif %}{{ a.rank }}</div>
      <div class="rankbar__body">
        {%- set tierLabel = "Gold" if a.rank == 1 else ("Silver" if a.rank == 2 else "Bronze") -%}
        <span class="rankbar__tier">{{ tierLabel }} · War Champ</span>
        <a class="rankbar__name" href="/roster/#member-{{ a.player_tag | memberSlug }}">{{ a.player_name | e }}</a>
        {% if a.metadata.races_participated %}<div class="rankbar__note">{{ a.metadata.races_participated }} race{{ "s" if a.metadata.races_participated != 1 }}{% if a.metadata.avg_fame %} · avg {{ a.metadata.avg_fame | formatNumber }} fame{% endif %}</div>{% endif %}
      </div>
      <div class="rankbar__metric">
        <span class="rankbar__big">{{ a.metric_value | formatNumber }}</span>
        <span class="rankbar__unit">{{ a.metric_unit }}</span>
      </div>
    </li>
    {% endfor %}
  </ol>
</section>
{% endif %}

<hr class="rule" />
<section class="section">
  <div class="section-head">
    <div class="section-head__copy">
      <span class="eyebrow">Promote the clan</span>
      <h2 class="h-display h2 mt-3">Plug-and-play pitches</h2>
      <p class="lede mt-3">Use these messages to recruit new players and grow <strong style="color:#fff">POAP KINGS</strong>.</p>
    </div>
  </div>

  <div class="promoTabs" role="tablist" aria-label="Promote channel">
    <button type="button" class="promoTab is-active" role="tab" aria-selected="true" aria-controls="promo-text" data-promo-tab="text">Text</button>
    <button type="button" class="promoTab" role="tab" aria-selected="false" aria-controls="promo-social" data-promo-tab="social">Social</button>
    <button type="button" class="promoTab" role="tab" aria-selected="false" aria-controls="promo-mail" data-promo-tab="mail">Mail</button>
    <button type="button" class="promoTab" role="tab" aria-selected="false" aria-controls="promo-discord" data-promo-tab="discord">Discord</button>
    <button type="button" class="promoTab" role="tab" aria-selected="false" aria-controls="promo-reddit" data-promo-tab="reddit">Reddit</button>
  </div>

  <div class="promoChannels">
    <div class="promoChannel" id="promo-text" role="tabpanel" data-promo-panel="text">
      <div class="promoChannelHeader">
        <h3 class="promoChannelLabel">Text</h3>
        <div class="promoChannelButtons">
          <a class="btn btn--ghost btn--sm promoSms" href="#" data-tinylytics-event="members.send-text">Send Message</a>
          <button class="btn btn--gold btn--sm promoChannelCopy" type="button" data-tinylytics-event="members.copy-text">COPY</button>
        </div>
      </div>
      <p class="promoChannelHint">Send this to a friend who plays Clash Royale.</p>
      <textarea class="promoChannelText" readonly rows="3">{{ elixirPromote.message.body | safe }}</textarea>
    </div>

    <div class="promoChannel" id="promo-social" role="tabpanel" data-promo-panel="social" hidden>
      <div class="promoChannelHeader">
        <h3 class="promoChannelLabel">Social</h3>
        <button class="btn btn--gold btn--sm promoChannelCopy" type="button" data-tinylytics-event="members.copy-social">COPY</button>
      </div>
      <p class="promoChannelHint">Post on X, Instagram, Threads, etc.</p>
      <textarea class="promoChannelText" readonly rows="3">{{ elixirPromote.social.body | safe }}</textarea>
    </div>

    <div class="promoChannel" id="promo-mail" role="tabpanel" data-promo-panel="mail" hidden>
      <div class="promoChannelHeader">
        <h3 class="promoChannelLabel">Mail</h3>
        <div class="promoChannelButtons">
          <a class="btn btn--ghost btn--sm promoMailto" href="#" data-tinylytics-event="members.send-email">Send Email</a>
          <button class="btn btn--gold btn--sm promoChannelCopy" type="button" data-tinylytics-event="members.copy-email">COPY</button>
        </div>
      </div>
      <p class="promoChannelHint">Email-friendly pitch for friends or group chats.</p>
      <label class="promoFieldLabel">Subject</label>
      <input class="promoFieldInput" type="text" readonly value="{{ elixirPromote.email.subject | safe }}" />
      <textarea class="promoChannelText" readonly rows="5">{{ elixirPromote.email.body | safe }}</textarea>
    </div>

    <div class="promoChannel" id="promo-discord" role="tabpanel" data-promo-panel="discord" hidden>
      <div class="promoChannelHeader">
        <h3 class="promoChannelLabel">Discord</h3>
        <div class="promoChannelButtons">
          <a class="btn btn--ghost btn--sm" href="https://discord.com/channels/332526643182567425/354394732451069953" target="_blank" rel="noreferrer" data-tinylytics-event="members.open-discord">Open Discord</a>
          <button class="btn btn--gold btn--sm promoChannelCopy" type="button" data-tinylytics-event="members.copy-discord">COPY</button>
        </div>
      </div>
      <p class="promoChannelHint">Drop this in a Clash Royale or gaming Discord server.</p>
      <textarea class="promoChannelText" readonly rows="4">{{ elixirPromote.discord.body | safe }}</textarea>
    </div>

    <div class="promoChannel" id="promo-reddit" role="tabpanel" data-promo-panel="reddit" hidden>
      <div class="promoChannelHeader">
        <h3 class="promoChannelLabel">Reddit</h3>
        <div class="promoChannelButtons">
          <a class="btn btn--ghost btn--sm" href="https://www.reddit.com/r/RoyaleRecruit/" target="_blank" rel="noreferrer" data-tinylytics-event="members.open-subreddit">Open Subreddit</a>
          <button class="btn btn--gold btn--sm promoChannelCopy" type="button" data-tinylytics-event="members.copy-reddit">COPY</button>
        </div>
      </div>
      <p class="promoChannelHint">Post this into r/RoyaleRecruit. Do not include the clan invite link!</p>
      <label class="promoFieldLabel">Title</label>
      <input class="promoFieldInput" type="text" readonly value="{{ elixirPromote.reddit.title | safe }}" />
      <textarea class="promoChannelText" readonly rows="5">{{ elixirPromote.reddit.body | safe }}</textarea>
    </div>
  </div>

  <script>
    (function(){
      var tablist = document.querySelector('.promoTabs[role="tablist"]');
      if (!tablist) return;
      var tabs = tablist.querySelectorAll('.promoTab');
      var panels = document.querySelectorAll('[data-promo-panel]');
      function select(key){
        tabs.forEach(function(t){
          var on = t.dataset.promoTab === key;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach(function(p){ p.hidden = p.dataset.promoPanel !== key; });
      }
      tablist.addEventListener('click', function(e){
        var btn = e.target.closest('.promoTab');
        if (btn) select(btn.dataset.promoTab);
      });
      tablist.addEventListener('keydown', function(e){
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        var list = Array.prototype.slice.call(tabs);
        var cur = list.findIndex(function(t){ return t.classList.contains('is-active'); });
        var next = e.key === 'ArrowRight' ? (cur + 1) % list.length : (cur - 1 + list.length) % list.length;
        select(list[next].dataset.promoTab);
        list[next].focus();
      });
    })();
  </script>

  <div class="ctaRow mt-5">
    <a class="btn btn--purple btn--sm" href="https://tinylytics.app/public/{{ site.tinylyticsId }}?token=poapkings" target="_blank" rel="noreferrer" data-tinylytics-event="members.view-traffic">View site traffic →</a>
  </div>
</section>
