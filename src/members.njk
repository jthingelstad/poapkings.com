---
permalink: /members/
layout: base.njk
title: "Members | POAP KINGS | A Clash Royale Clan with Proof"
description: "Members — onboarding and member resources for POAP KINGS."
navActive: members
extraScripts: '<script src="/members-promo.js"></script>'
---
    <section class="pageIntro card">
      <h1 class="pageTitle">Welcome KING...</h1>
      <p class="sectionDesc">
        Members is your resource hub for clan news, awards, promotion tools, and site updates. Everything you need as a <strong>POAP KINGS</strong> member is right here.
      </p>
      <p class="sectionDesc"><strong>New to the clan?</strong> Get connected with leaders, set up your wallet, and register for the roster.</p>
      <div class="ctaRow mt-sm">
        <a class="btn btnPrimary" href="/members/setup/" data-tinylytics-event="members.clan-setup">Clan Setup</a>
        <a class="btn btnGhost" href="/faq" data-tinylytics-event="members.read-faq">Read the FAQ</a>
      </div>
    </section>

    <section>
      <div class="card card-padded">
        <h2 class="sectionTitle m-0 mb-xs">Pass Winners</h2>
        <p class="sectionDesc m-0 mb-md">These members won the war and earned a Royal Pass from the clan. Congrats to all the winners!</p>
        <ul class="passWinnersList">
          {%- for entry in winners %}
          <li><strong>Season {{ entry.season }}</strong> — {{ entry.winner }}</li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section>
      <div class="card card-padded">
        <h2 class="sectionTitle m-0 mb-xs">Promote the Clan</h2>
        <p class="sectionDesc m-0 mb-md">
          Use these plug-and-play messages to recruit new players and grow <strong>POAP KINGS</strong>.
        </p>
        <div class="promoChannels">
          <div class="promoChannel">
            <div class="promoChannelHeader">
              <h3 class="promoChannelLabel">Text</h3>
              <div class="promoChannelButtons">
                <a class="btn btnGhost btnSm promoSms" href="#" data-tinylytics-event="members.send-text">Send Message</a>
                <button class="btn btnPrimary promoChannelCopy" type="button" data-tinylytics-event="members.copy-text">COPY</button>
              </div>
            </div>
            <p class="promoChannelHint">Send this to a friend who plays Clash Royale.</p>
            <textarea class="promoChannelText" readonly rows="3">
{{ promote.message.body | safe }}
            </textarea>
          </div>

          <div class="promoChannel">
            <div class="promoChannelHeader">
              <h3 class="promoChannelLabel">Social</h3>
              <button class="btn btnPrimary promoChannelCopy" type="button" data-tinylytics-event="members.copy-social">COPY</button>
            </div>
            <p class="promoChannelHint">Post on X, Instagram, Threads, etc.</p>
            <textarea class="promoChannelText" readonly rows="3">
{{ promote.social.body | safe }}
            </textarea>
          </div>

          <div class="promoChannel">
            <div class="promoChannelHeader">
              <h3 class="promoChannelLabel">Mail</h3>
              <div class="promoChannelButtons">
                <a class="btn btnGhost btnSm promoMailto" href="#" data-tinylytics-event="members.send-email">Send Email</a>
                <button class="btn btnPrimary promoChannelCopy" type="button" data-tinylytics-event="members.copy-email">COPY</button>
              </div>
            </div>
            <p class="promoChannelHint">Email-friendly pitch for friends or group chats.</p>
            <label class="promoFieldLabel">Subject</label>
            <input class="promoFieldInput" type="text" readonly value="{{ promote.email.subject | safe }}" />
            <textarea class="promoChannelText" readonly rows="5">
{{ promote.email.body | safe }}
            </textarea>
          </div>

          <div class="promoChannel">
            <div class="promoChannelHeader">
              <h3 class="promoChannelLabel">Discord</h3>
              <div class="promoChannelButtons">
                <a class="btn btnGhost btnSm" href="https://discord.com/channels/332526643182567425/354394732451069953" target="_blank" rel="noreferrer" data-tinylytics-event="members.open-discord">Open Discord</a>
                <button class="btn btnPrimary promoChannelCopy" type="button" data-tinylytics-event="members.copy-discord">COPY</button>
              </div>
            </div>
            <p class="promoChannelHint">Drop this in a Clash Royale or gaming Discord server.</p>
            <textarea class="promoChannelText" readonly rows="4">
{{ promote.discord.body | safe }}
            </textarea>
          </div>

          <div class="promoChannel">
            <div class="promoChannelHeader">
              <h3 class="promoChannelLabel">Reddit</h3>
              <div class="promoChannelButtons">
                <a class="btn btnGhost btnSm" href="https://www.reddit.com/r/RoyaleRecruit/" target="_blank" rel="noreferrer" data-tinylytics-event="members.open-subreddit">Open Subreddit</a>
                <button class="btn btnPrimary promoChannelCopy" type="button" data-tinylytics-event="members.copy-reddit">COPY</button>
              </div>
            </div>
            <p class="promoChannelHint">Post this into r/RoyaleRecruit. Do not attempt to include the clan invite link!</p>
            <label class="promoFieldLabel">Title</label>
            <input class="promoFieldInput" type="text" readonly value="{{ promote.reddit.title | safe }}" />
            <textarea class="promoChannelText" readonly rows="5">
{{ promote.reddit.body | safe }}
            </textarea>
          </div>
        </div>
        <div class="ctaRow mt-sm">
          <a class="btn btnPrimary" href="https://tinylytics.app/public/nqAdZqEbeis65byoh2_3?token=poapkings" target="_blank" rel="noreferrer" data-tinylytics-event="members.view-traffic">📊 View Site Traffic</a>
          <div class="hitCounter">
            <span class="hitEmoji" aria-hidden="true">👑</span>
            <span class="tinylytics_hits"></span>
            <span class="hitLabel">hits</span>
          </div>
        </div>
      </div>
    </section>
