<div class="clanStat">
  <div class="clanStatValue">{{ clan.memberCount }}</div>
  <div class="clanStatLabel">Members</div>
</div>
<div class="clanStat">
  <div class="clanStatValue">{{ clan.clanWarTrophies | formatNumber }}</div>
  <div class="clanStatLabel">War Trophies</div>
</div>
<div class="clanStat">
  <div class="clanStatValue">{{ clan.clanScore | formatNumber }}</div>
  <div class="clanStatLabel">Clan Trophies</div>
</div>
<div class="clanStat">
  <div class="clanStatValue">{{ clan.donationsPerWeek | formatNumber }}</div>
  <div class="clanStatLabel">Donations / Week</div>
</div>
<div class="clanStat">
  <div class="clanStatValue">{{ clan.totalTrophies | formatNumber }}</div>
  <div class="clanStatLabel">Total Trophies</div>
</div>
<div class="clanStat">
  <div class="clanStatValue">{{ clan.minTrophies | formatNumber }}</div>
  <div class="clanStatLabel">Min Trophies</div>
</div>
