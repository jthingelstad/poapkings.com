<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#070610" />
  <meta name="description" content="{{ description }}" />
  <title>{{ title }}</title>

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/assets/favicon/favicon-192.png" />

  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" type="application/rss+xml" title="POAP KINGS" href="/feed.xml" />
  <link rel="alternate" type="text/markdown" title="POAP KINGS for LLMs" href="/llms.txt" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="website" />
  {%- set resolvedOgImage = ogImage or '/assets/poapkings.png' -%}
  {%- set fullOgImage = resolvedOgImage if resolvedOgImage.startsWith('http') else (site.url + resolvedOgImage) -%}
  <meta property="og:image" content="{{ fullOgImage }}" />
  <meta property="og:image:alt" content="{{ ogImageAlt or 'POAP KINGS crest' }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ fullOgImage }}" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "POAP KINGS",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/poapkings.png",
    "description": "{{ site.tagline }} — A Clash Royale clan with proof."
  }
  </script>

  <link rel="webmention" href="https://tinylytics.app/webmention/{{ site.tinylyticsId }}" />

  <link rel="stylesheet" href="{{ '/styles.css' | bust }}" />
</head>

<body{% if navActive %} data-nav="{{ navActive }}"{% endif %}>
  <header class="top">
    <div class="wrap top__inner">
      {%- set isFull = elixirClan.memberCount >= 50 -%}
      <div class="top__left">
        {% if isFull %}
        <button type="button" class="nav-join nav-join--full" data-modal-open="join" data-tinylytics-event="nav.waitlist" aria-haspopup="dialog" aria-controls="joinModal" title="Clan is full — join the waitlist">WAIT<span class="nav-join__dot" aria-hidden="true"></span></button>
        {% else %}
        <button type="button" class="nav-join" data-modal-open="join" data-tinylytics-event="nav.join" aria-haspopup="dialog" aria-controls="joinModal">JOIN</button>
        {% endif %}
        <a class="brand" href="/" aria-label="POAP KINGS home">
          <span class="brand__mark">POAP&nbsp;KINGS</span>
        </a>
      </div>
      <nav class="navbar" id="navMenu" aria-label="Primary">
        <a href="/"{% if navActive == "home" %} class="navbar__mobile-only is-active"{% else %} class="navbar__mobile-only"{% endif %} data-nav-link>Home</a>
        <a href="/roster"{% if navActive == "roster" %} class="is-active"{% endif %} data-nav-link>Roster</a>
        <a href="/awards"{% if navActive == "awards" %} class="is-active"{% endif %} data-nav-link>Awards</a>
        <a href="/blog"{% if navActive == "blog" %} class="is-active"{% endif %} data-nav-link>Blog</a>
        <a href="/members"{% if navActive == "members" %} class="is-active"{% endif %} data-nav-link>Members</a>
        <a href="/faq"{% if navActive == "faq" %} class="navbar__mobile-only is-active"{% else %} class="navbar__mobile-only"{% endif %} data-nav-link>FAQ</a>
        <a href="/elixir"{% if navActive == "elixir" %} class="navbar__mobile-only is-active"{% else %} class="navbar__mobile-only"{% endif %} data-nav-link>Elixir</a>
        <a class="navbar__mobile-only" href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" data-nav-link>Discord</a>
      </nav>
      <div class="top__right">
        <button type="button" class="nav-toggle" aria-label="Open menu" aria-controls="navMenu" aria-expanded="false" data-nav-toggle>
          <span></span><span></span><span></span>
        </button>
        <a class="starcount" href="https://tinylytics.app/public/{{ site.tinylyticsId }}" target="_blank" rel="noreferrer" aria-label="Clan Star Level — site hits" title="Clan Star Level — every visit adds a star">
          <img class="starcount__icon" src="/assets/icons/star-level.png" alt="" aria-hidden="true" />
          <span class="starcount__n tinylytics_hits">★</span>
        </a>
      </div>
    </div>
  </header>

  <main{% if mainId %} id="{{ mainId }}"{% endif %} class="wrap pageMain">
    {{ content | safe }}
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot__grid">
        <div class="foot__col">
          <div class="foot__brand">POAP KINGS</div>
          <p class="foot__tag">{{ site.tagline }}. Different flags. Same grind. Worldwide push.</p>
        </div>
        <div class="foot__col">
          <h4>The Clan</h4>
          <a href="/">Home</a>
          <a href="/roster">Roster</a>
          <a href="/awards">Awards</a>
          <a href="/blog">Blog</a>
        </div>
        <div class="foot__col">
          <h4>Members</h4>
          <a href="/members">Members Hub</a>
          <a href="/members/setup/">Clan Setup</a>
          <a href="/faq">FAQ</a>
          <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer">Discord</a>
        </div>
        <div class="foot__col">
          <h4>Projects</h4>
          <a href="/elixir">Elixir — the AI agent</a>
          <a href="/feed.xml">RSS Feed</a>
          <a href="https://collections.poap.xyz/organizations/poap-kings" target="_blank" rel="noreferrer">POAP.xyz</a>
          <a href="https://github.com/jthingelstad/poapkings.com" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
      <div class="foot__bot">
        <div>
          Content <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noreferrer">CC BY-SA 4.0</a>{% if supercellDisclaimer %} · Not affiliated with <a href="https://supercell.com" target="_blank" rel="noreferrer">Supercell</a>{% endif %}
        </div>
        <div><span class="tinylytics_hits"></span> hits</div>
      </div>
    </div>
  </footer>

  <div id="joinModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="joinModalTitle" hidden>
    <button type="button" class="modal__scrim" aria-label="Close dialog" data-modal-close></button>
    <div class="modal__panel modal__panel--{% if isFull %}wait{% else %}join{% endif %}">
      <button type="button" class="modal__close" aria-label="Close" data-modal-close>×</button>
      {% if isFull %}
      <span class="eyebrow eyebrow--purple">Waitlist</span>
      <h2 class="h-display h2 modal__title" id="joinModalTitle">The clan<br/>is full.</h2>
      <p class="modal__body">All 50 seats are taken right now. Drop into our Discord as a guest and hang out in <code>#courtyard</code> — leadership will tag you when a spot opens up. The roster turns over every season.</p>
      <p class="modal__hint">Minimum {{ elixirClan.minTrophies | formatNumber }}+ trophies when a spot does open.</p>
      <div class="modal__actions">
        <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" class="btn btn--purple" data-tinylytics-event="modal.discord" data-modal-close>Open Discord →</a>
        <button type="button" class="btn btn--ghost" data-modal-close>Not right now</button>
      </div>
      {% else %}
      <span class="eyebrow">Join POAP KINGS</span>
      <h2 class="h-display h2 modal__title" id="joinModalTitle">Ready to<br/>push?</h2>
      <p class="modal__body">The button below opens <strong style="color:#fff">Clash Royale</strong> on your phone and sends the clan invite straight to our leadership. Open the site on mobile to use it — on desktop, search for <strong>POAP KINGS</strong> in-game instead.</p>
      <dl class="modal__dl">
        <div><dt>Clan Name</dt><dd>POAP KINGS</dd></div>
        <div><dt>Clan Tag</dt><dd class="mono">#{{ site.clanTag }}</dd></div>
        <div><dt>Min Trophies</dt><dd>{{ elixirClan.minTrophies | formatNumber }}</dd></div>
        <div><dt>Status</dt><dd>{{ elixirClan.clanStatus }}</dd></div>
      </dl>
      <div class="modal__actions">
        <a href="{{ site.joinUrl }}" target="_blank" rel="noreferrer" class="btn btn--gold" data-tinylytics-event="modal.launch-cr" data-modal-close>Launch Clash Royale →</a>
        <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
      </div>
      {% endif %}
    </div>
  </div>

  <script>
    (function(){
      var modal = document.getElementById('joinModal');
      if (!modal) return;
      var lastFocus = null;
      function open(){
        lastFocus = document.activeElement;
        modal.hidden = false;
        document.body.classList.add('modal-open');
        requestAnimationFrame(function(){ modal.classList.add('is-open'); });
        var primary = modal.querySelector('.btn--gold, .btn--purple');
        if (primary) primary.focus();
      }
      function close(){
        modal.classList.remove('is-open');
        document.body.classList.remove('modal-open');
        setTimeout(function(){ modal.hidden = true; }, 200);
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      }
      document.addEventListener('click', function(e){
        var opener = e.target.closest('[data-modal-open="join"]');
        if (opener){ e.preventDefault(); open(); return; }
        if (e.target.closest('[data-modal-close]')) close();
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && !modal.hidden) close();
      });
    })();

    // Mobile hamburger dropdown
    (function(){
      var toggle = document.querySelector('[data-nav-toggle]');
      var nav = document.getElementById('navMenu');
      if (!toggle || !nav) return;
      function setOpen(open){
        toggle.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('is-open', open);
        document.body.classList.toggle('nav-open', open);
      }
      toggle.addEventListener('click', function(e){
        e.stopPropagation();
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
      nav.addEventListener('click', function(e){
        if (e.target.closest('[data-nav-link]')) setOpen(false);
      });
      document.addEventListener('click', function(e){
        if (!nav.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') setOpen(false);
      });
    })();
  </script>

  {% if appJs %}<script src="{{ '/app.js' | bust }}"></script>{% endif %}
  <script src="{{ '/gamify.js' | bust }}" defer></script>
  <script src="{{ '/partials-trophy.js' | bust }}" defer></script>
  <script src="https://tinylytics.app/embed/{{ site.tinylyticsId }}.js?hits&kudos=%F0%9F%91%8F&countries&events&beacon" defer></script>
  {{ extraScripts | safe }}
</body>
</html>
