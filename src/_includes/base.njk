<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#070610" />
  <meta name="description" content="{{ description }}" />
  <title>{{ title }}</title>

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/assets/favicon/favicon-192.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" type="text/markdown" title="POAP KINGS for LLMs" href="/llms.txt" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="website" />
  {%- if ogImage -%}
  {%- set fullOgImage = ogImage if ogImage.startsWith('http') else (site.url + ogImage) -%}
  <meta property="og:image" content="{{ fullOgImage }}" />
  <meta property="og:image:alt" content="{{ ogImageAlt or title }}" />
  {%- if ogImageWidth %}<meta property="og:image:width" content="{{ ogImageWidth }}" />{% endif %}
  {%- if ogImageHeight %}<meta property="og:image:height" content="{{ ogImageHeight }}" />{% endif %}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="{{ fullOgImage }}" />
  {%- else -%}
  <meta name="twitter:card" content="summary" />
  {%- endif %}
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "POAP KINGS",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/poapkings.png",
    "description": "{{ site.tagline }} — A Clash Royale clan with proof."
  }
  </script>

  <link rel="webmention" href="https://tinylytics.app/webmention/{{ site.tinylyticsId }}" />

  <link rel="stylesheet" href="{{ '/styles.css' | bust }}" />
</head>

<body{% if navActive %} data-nav="{{ navActive }}"{% endif %}>
  {%- set isFull = clan.memberCount >= 50 -%}
  {%- set navLinks = [
    { url: "/", key: "home", label: "Home" },
    { url: "/roster/", key: "roster", label: "Roster" },
    { url: "/data/", key: "data", label: "Data" },
    { url: "/faq/", key: "faq", label: "FAQ" }
  ] -%}
  <header class="site-head">
    <nav class="site-head__nav" aria-label="Primary">
      <a class="site-head__brand" href="/" aria-label="POAP KINGS home">
        <img class="site-head__crest" src="/assets/poapkings.png" alt="" />
        <span class="site-head__wordmark">POAP KINGS</span>
      </a>
      <div class="site-head__links pk-nav-links">
        {%- for item in navLinks %}
        <a href="{{ item.url }}" class="site-head__link{% if navActive == item.key %} is-active{% endif %}" data-nav-link>{{ item.label }}</a>
        {%- endfor %}
      </div>
      <div class="site-head__right">
        <a href="/members/" class="site-head__members pk-hide-mobile{% if navActive == 'members' %} is-active{% endif %}" data-nav-link>Members <span aria-hidden="true">›</span></a>
        {% if isFull %}
        <button type="button" class="site-head__join site-head__join--full" data-modal-open="join" data-tinylytics-event="nav.waitlist" aria-haspopup="dialog" aria-controls="joinModal" title="Clan is full — join the waitlist">WAIT</button>
        {% else %}
        <button type="button" class="site-head__join" data-modal-open="join" data-tinylytics-event="nav.join" aria-haspopup="dialog" aria-controls="joinModal">JOIN</button>
        {% endif %}
        <button type="button" class="starcount" data-modal-open="star" data-tinylytics-event="nav.stars" aria-haspopup="dialog" aria-controls="starModal" aria-label="Clan Star Level — open details" title="Clan Star Level — every visit adds a star">
          <img class="starcount__icon" src="/assets/icons/star-level.png" alt="" aria-hidden="true" />
          <span class="starcount__n tinylytics_hits">★</span>
        </button>
        <button type="button" class="pk-hamburger" data-nav-toggle aria-label="Open menu" aria-controls="navMenu" aria-expanded="false">
          <span class="pk-hamburger__lines" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </nav>
    <div class="site-head__drawer" id="navMenu">
      {%- for item in navLinks %}
      <a href="{{ item.url }}" class="site-head__drawer-link{% if navActive == item.key %} is-active{% endif %}" data-nav-link>{{ item.label }}</a>
      {%- endfor %}
      <a href="/members/" class="site-head__drawer-link site-head__drawer-link--members{% if navActive == 'members' %} is-active{% endif %}" data-nav-link>Members ›</a>
    </div>
  </header>

  <main{% if mainId %} id="{{ mainId }}"{% endif %} class="pageMain">
    {{ content | safe }}
  </main>

  <footer class="site-foot">
    <div class="wrap site-foot__row">
      <img class="site-foot__crest" src="/assets/poapkings.png" alt="" />
      <span class="site-foot__brand">POAP KINGS</span>
      <span class="site-foot__tag">{{ site.tagline }} · #{{ site.clanTag }}</span>
      <span class="site-foot__links">
        <a href="https://drop.poapkings.com" target="_blank" rel="noreferrer">Elixir Drop</a>
        <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer">Discord</a>
        <a href="https://github.com/jthingelstad/poapkings.com" target="_blank" rel="noreferrer">GitHub</a>
        <span class="site-foot__hits"><span class="tinylytics_hits"></span> hits</span>
      </span>
    </div>
    <div class="wrap site-foot__legal">
      Content <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noreferrer">CC BY-SA 4.0</a>{% if supercellDisclaimer %} · This material is unofficial and is not endorsed by Supercell. For more information see Supercell's Fan Content Policy: <a href="https://www.supercell.com/fan-content-policy" target="_blank" rel="noreferrer">www.supercell.com/fan-content-policy</a>.{% endif %}
    </div>
  </footer>

  <div id="joinModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="joinModalTitle" hidden>
    <button type="button" class="modal__scrim" aria-label="Close dialog" data-modal-close></button>
    <div class="modal__panel modal__panel--{% if isFull %}wait{% else %}join{% endif %}">
      <button type="button" class="modal__close" aria-label="Close" data-modal-close>×</button>
      {% if isFull %}
      <span class="eyebrow eyebrow--purple">Waitlist</span>
      <h2 class="h-display h2 modal__title" id="joinModalTitle">The clan<br/>is full.</h2>
      <p class="modal__body">All 50 seats are taken right now. Drop into our Discord as a guest and hang out in <code>#courtyard</code> — leadership will tag you when a spot opens up. The roster turns over every season.</p>
      <p class="modal__hint">Minimum {{ clan.minTrophies | formatNumber }}+ trophies when a spot does open.</p>
      <div class="modal__actions">
        <a href="{{ site.discordUrl }}" target="_blank" rel="noreferrer" class="btn btn--purple" data-tinylytics-event="modal.discord" data-modal-close>Open Discord →</a>
        <button type="button" class="btn btn--ghost" data-modal-close>Not right now</button>
      </div>
      {% else %}
      <span class="eyebrow">Join POAP KINGS</span>
      <h2 class="h-display h2 modal__title" id="joinModalTitle">Ready to<br/>push?</h2>
      <p class="modal__body">The button below opens <strong>Clash Royale</strong> on your phone and sends the clan invite straight to our leadership. Open the site on mobile to use it — on desktop, search for <strong>POAP KINGS</strong> in-game instead.</p>
      <dl class="modal__dl">
        <div><dt>Clan Name</dt><dd>POAP KINGS</dd></div>
        <div><dt>Clan Tag</dt><dd class="mono">#{{ site.clanTag }}</dd></div>
        <div><dt>Min Trophies</dt><dd>{{ clan.minTrophies | formatNumber }}</dd></div>
        <div><dt>Status</dt><dd>{{ clan.clanStatus }}</dd></div>
      </dl>
      <div class="modal__actions">
        <a href="{{ site.joinUrl }}" target="_blank" rel="noreferrer" class="btn btn--gold" data-tinylytics-event="modal.launch-cr" data-modal-close>Launch Clash Royale →</a>
        <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
      </div>
      {% endif %}
    </div>
  </div>

  {%- set firstRank = starRanks.ranks[0] -%}
  <div id="starModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="starModalTitle" hidden>
    <button type="button" class="modal__scrim" aria-label="Close dialog" data-modal-close></button>
    <div class="modal__panel modal__panel--star">
      <button type="button" class="modal__close" aria-label="Close" data-modal-close>×</button>
      <span class="eyebrow">Clan Stars</span>
      <h2 class="h-display h2 modal__title" id="starModalTitle">Every visit<br/>adds a star.</h2>
      <p class="modal__body">Our clan's website is grinding the ladder! Your visit counts.</p>

      <div class="rank-card" data-rank-card>
        <div class="rank-card__art" data-rank-art>
          <div class="rank-card__placeholder" data-rank-placeholder><span data-rank-num>1</span></div>
        </div>
        <div class="rank-card__meta">
          <div class="rank-card__eyebrow">Current rank</div>
          <div class="rank-card__name" data-rank-name>{{ firstRank.name }}</div>
          <div class="rank-card__count"><span class="tinylytics_hits" data-rank-count>—</span> stars</div>
          <div class="rank-progress" data-rank-progress>
            <div class="rank-progress__fill" data-rank-fill></div>
          </div>
          <div class="rank-progress__label" data-rank-label>Loading…</div>
        </div>
      </div>

      <p class="modal__hint">Hits powered by <a href="https://tinylytics.app/public/{{ site.tinylyticsId }}" target="_blank" rel="noreferrer" data-tinylytics-event="modal.tinylytics-dashboard">Tinylytics</a>. Arena artwork © Supercell — used under <a href="https://www.supercell.com/fan-content-policy" target="_blank" rel="noreferrer" data-tinylytics-event="modal.fan-policy">Supercell's Fan Content Policy</a>.</p>
    </div>
  </div>

  <script id="starRanksData" type="application/json">{{ starRanks.ranks | jsonForScript | safe }}</script>

  <script>
    (function(){
      var modals = {
        join: document.getElementById('joinModal'),
        star: document.getElementById('starModal')
      };
      var current = null;
      var lastFocus = null;
      function open(name){
        var modal = modals[name];
        if (!modal) return;
        current = modal;
        lastFocus = document.activeElement;
        modal.hidden = false;
        document.body.classList.add('modal-open');
        requestAnimationFrame(function(){ modal.classList.add('is-open'); });
        modal.dispatchEvent(new CustomEvent('modal:open'));
        var primary = modal.querySelector('.btn--gold, .btn--purple, .modal__close');
        if (primary) primary.focus();
      }
      function close(){
        if (!current) return;
        var modal = current;
        modal.classList.remove('is-open');
        document.body.classList.remove('modal-open');
        setTimeout(function(){ modal.hidden = true; }, 200);
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
        current = null;
      }
      document.addEventListener('click', function(e){
        var opener = e.target.closest('[data-modal-open]');
        if (opener){ e.preventDefault(); open(opener.getAttribute('data-modal-open')); return; }
        if (e.target.closest('[data-modal-close]')) close();
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && current) close();
      });
    })();

    // Mobile hamburger dropdown
    (function(){
      var toggle = document.querySelector('[data-nav-toggle]');
      var nav = document.getElementById('navMenu');
      if (!toggle || !nav) return;
      function setOpen(open){
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        nav.classList.toggle('is-open', open);
        document.body.classList.toggle('nav-open', open);
      }
      toggle.addEventListener('click', function(e){
        e.stopPropagation();
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
      nav.addEventListener('click', function(e){
        if (e.target.closest('[data-nav-link]')) setOpen(false);
      });
      document.addEventListener('click', function(e){
        if (!nav.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') setOpen(false);
      });
    })();
  </script>

  <script type="module" src="{{ '/gamify.js' | bust }}"></script>
  <script src="https://tinylytics.app/embed/{{ site.tinylyticsId }}.js?hits&kudos=%F0%9F%91%8F&countries&events&beacon" defer></script>
  {{ extraScripts | safe }}
</body>
</html>
