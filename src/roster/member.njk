---
layout: base.njk
pagination:
  data: elixirRoster.members
  size: 1
  alias: member
navActive: roster
eleventyComputed:
  permalink: "/roster/{{ member.tag | memberSlug }}/"
  title: "{{ member.name }} | POAP KINGS Roster"
  description: "{{ member.name }} is a {{ member.role or 'Member' }} in POAP KINGS with {{ member.trophies | formatNumber }} trophies in {{ member.arena }}."
  ogImage: "{{ member.favorite_cards[0].icon_url if (member.favorite_cards and member.favorite_cards.length) else '/assets/poapkings.png' }}"
  ogImageAlt: "{{ member.name }}'s top card: {{ member.favorite_cards[0].name if (member.favorite_cards and member.favorite_cards.length) else 'POAP KINGS' }}"
---
{%- set role = member.role if member.role else "Member" -%}
{%- set roleSlug = role | lower | replace("-", "") -%}
{%- set profileUrl = member.profile_url | safeUrl -%}
{%- set poapUrl = member.poap_address | poapCollectionUrl -%}
{%- set rawTag = member.tag | memberSlug | upper -%}
{%- set sigCard = member.favorite_cards[0] if (member.favorite_cards and member.favorite_cards.length) else null -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ member.name | e }}",
  "url": "{{ site.url }}/roster/{{ member.tag | memberSlug }}/",
  "memberOf": {
    "@type": "Organization",
    "name": "POAP KINGS",
    "url": "{{ site.url }}"
  }{% if sigCard %},
  "image": "{{ sigCard.icon_url }}"{% endif %}
}
</script>

<a class="back-link" href="/roster/">← Back to roster</a>

<section class="pl-hero">
  <div class="pl-hero__signature">
    {% if sigCard %}
    <img src="{{ sigCard.icon_url | e }}" alt="{{ sigCard.name | e }}" />
    {% else %}
    <div class="pl-hero__signature__placeholder">{{ member.name | upper | truncate(1, true, '') }}</div>
    {% endif %}
  </div>
  <div class="pl-hero__copy">
    <div class="eyebrow">Player Profile</div>
    <h1 class="pl-hero__name">{{ member.name | e }}</h1>
    <p class="pl-hero__bio">{% if member.bio %}{{ member.bio | e }}{% else %}{{ member.name | e }} is currently ranked #{{ member.clan_rank }} in POAP KINGS, battling in {{ member.arena | e }} with {{ member.trophies | formatNumber }} trophies.{% endif %}</p>
    <div class="pl-hero__pills">
      <span class="pl-pill pl-pill--role-{{ roleSlug }}">{{ role | e }}</span>
      <span class="pl-pill pl-pill--tag">#{{ rawTag | e }}</span>
      <span class="pl-pill">{{ member.arena | e }}</span>
      {% if member.date_joined %}<span class="pl-pill">Joined {{ member.date_joined | formatDate }}</span>{% endif %}
      {% if member.note %}<span class="pl-pill pl-pill--gold">{{ member.note | e }}</span>{% endif %}
    </div>
  </div>
  <div class="pl-hero__stats">
    <div class="pl-hero__stat">
      <div class="pl-hero__stat__n pl-hero__stat__n--gold">{{ member.trophies | formatNumber }}</div>
      <div class="pl-hero__stat__l">Trophies</div>
    </div>
    <div class="pl-hero__stat">
      <div class="pl-hero__stat__n">{{ member.exp_level or '—' }}</div>
      <div class="pl-hero__stat__l">King Level</div>
    </div>
    <div class="pl-hero__stat">
      <div class="pl-hero__stat__n">#{{ member.clan_rank or '—' }}</div>
      <div class="pl-hero__stat__l">Clan Rank</div>
    </div>
  </div>
</section>

<div class="pl-meta">
  {% if member.cr_account_age_years %}<span><span class="pl-meta__label">Account age</span><span class="pl-meta__v">{{ member.cr_account_age_years }} years</span></span>{% endif %}
  {% if member.cr_games_per_day != null %}<span><span class="pl-meta__label">Activity</span><span class="pl-meta__v">{{ member.cr_games_per_day | formatDecimal(1) }} games/day · last {{ member.cr_games_per_day_window_days or 14 }}d</span></span>{% endif %}
  <span><span class="pl-meta__label">Donations</span><span class="pl-meta__v">{{ member.donations | formatNumber }} sent · {{ member.donations_received | formatNumber }} received</span></span>
  {% if member.last_seen %}<span><span class="pl-meta__label">Last seen</span><span class="pl-meta__v">{{ member.last_seen | formatLastSeen }}</span></span>{% endif %}
  {% if member.badge_count != null %}<span><span class="pl-meta__label">Badges</span><span class="pl-meta__v">{{ member.badge_count | formatNumber }}</span></span>{% endif %}
  {% if member.achievement_star_count != null %}<span><span class="pl-meta__label">Achievement stars</span><span class="pl-meta__v">{{ member.achievement_star_count | formatNumber }}</span></span>{% endif %}
</div>

<div class="pl-actions">
  <a class="btn btn--gold" href="{{ member.tag | royaleApiUrl | e }}" target="_blank" rel="noreferrer">RoyaleAPI ↗</a>
  {% if profileUrl %}<a class="btn btn--ghost" href="{{ profileUrl | e }}" target="_blank" rel="noreferrer">Profile ↗</a>{% endif %}
  {% if poapUrl %}<a class="btn btn--ghost" href="{{ poapUrl | e }}" target="_blank" rel="noreferrer">POAP Collection ↗</a>{% endif %}
  <button class="tinylytics_kudos" data-path="/roster/{{ member.tag | memberSlug | e }}"></button>
</div>

{% if (member.favorite_cards and member.favorite_cards.length) or (member.current_deck_cards and member.current_deck_cards.length) %}
<div class="pl-split">
  {% if member.favorite_cards and member.favorite_cards.length %}
  <div class="pl-card">
    <h2>Favorite Cards</h2>
    <p class="sub">Most-used cards across recent battle data.</p>
    {% for card in member.favorite_cards %}
    <div class="pl-fav">
      <div class="pl-fav__icon"><img src="{{ card.icon_url | e }}" alt="{{ card.name | e }}" loading="lazy" /></div>
      <div>
        <div class="pl-fav__name">{{ card.name | e }}</div>
        <div class="pl-fav__meta">Used in {{ card.usage_pct }}% of tracked decks</div>
      </div>
      <div class="pl-fav__pct">{{ card.usage_pct }}%</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if member.current_deck_cards and member.current_deck_cards.length %}
  {%- set totalElixir = 0 -%}
  {%- for card in member.current_deck_cards -%}{%- set totalElixir = totalElixir + (card.elixir_cost or 0) -%}{%- endfor -%}
  {%- set avgElixir = totalElixir / member.current_deck_cards.length -%}
  <div class="pl-card">
    <div class="pl-deck-head">
      <div>
        <h2>Current Deck</h2>
        <p class="sub">Cards currently on the roster feed.</p>
      </div>
      <div class="pl-elixir">
        <span class="pl-elixir__drop"></span>
        <div>
          <div class="pl-elixir__v">{{ avgElixir | formatDecimal(1) }}</div>
          <div class="pl-elixir__l">Avg Elixir</div>
        </div>
      </div>
    </div>
    <div class="pl-deck">
      {% for card in member.current_deck_cards %}
      {%- set cardImg = card.icon_urls.evolutionMedium if (card.evolution_level and card.icon_urls.evolutionMedium) else card.icon_url -%}
      {%- set rarityClass = (card.rarity or "common") | lower -%}
      <div class="pl-deck__card pl-deck__card--{{ rarityClass }}{% if card.evolution_level %} pl-deck__card--evo{% endif %}">
        <img src="{{ cardImg | e }}" alt="{{ card.name | e }}" loading="lazy" />
        <div class="pl-deck__card__name">{{ card.name | e }}</div>
        <div class="pl-deck__card__lvl">LVL {{ card.level }}</div>
        {% if card.star_level %}<div class="pl-deck__card__stars">{% for i in range(0, card.star_level) %}★{% endfor %}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if member.current_deck_support_cards and member.current_deck_support_cards.length %}
    <div class="pl-support">
      <span class="pl-support__label">Support</span>
      {% for card in member.current_deck_support_cards %}
      <span class="pl-support__item">
        <img src="{{ card.icon_url | e }}" alt="{{ card.name | e }}" loading="lazy" />
        <b>{{ card.name | e }}</b> Lvl {{ card.level }}
      </span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endif %}

{% if member.badge_highlights and member.badge_highlights.length %}
<section class="pl-section">
  <header>
    <div>
      <h2>Badges</h2>
      <p>Career and collection milestones. {{ member.badge_count or member.badge_highlights.length }} total earned.</p>
    </div>
  </header>
  <div class="pl-wall">
    {% for b in member.badge_highlights %}
    {%- set isMax = b.level >= b.max_level -%}
    <div class="pl-tile{% if isMax %} pl-tile--max{% endif %}" title="{{ b.label | e }} — Lvl {{ b.level }}/{{ b.max_level }}">
      <div class="pl-tile__name">{{ b.label | e }}</div>
      {% if b.icon_url %}<img src="{{ b.icon_url | e }}" alt="{{ b.label | e }}" loading="lazy" />{% endif %}
      <div class="pl-tile__lvl">{{ b.level }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if member.mastery_highlights and member.mastery_highlights.length %}
<section class="pl-section">
  <header>
    <div>
      <h2>Mastery</h2>
      <p>Cards pushed furthest in mastery.</p>
    </div>
  </header>
  <div class="pl-wall">
    {% for x in member.mastery_highlights %}
    {%- set complete = not x.target -%}
    {%- set tier = (((x.level / (x.max_level or 3)) * 3) | round) -%}
    {%- if tier < 1 -%}{%- set tier = 1 -%}{%- endif -%}
    {%- if tier > 3 -%}{%- set tier = 3 -%}{%- endif -%}
    <div class="pl-tile{% if complete %} pl-tile--max{% endif %}" title="{{ x.card_name | e }} — Lvl {{ x.level }}/{{ x.max_level }}">
      <div class="pl-tile__name">{{ x.card_name | e }}</div>
      <div class="pl-tile__stars">{% for i in range(0, tier) %}★{% endfor %}</div>
      {% if x.icon_url %}<img src="{{ x.icon_url | e }}" alt="{{ x.card_name | e }}" loading="lazy" />{% endif %}
      <div class="pl-tile__lvl">{% if complete %}MAX{% else %}Lvl {{ x.level }}{% endif %}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if member.achievement_progress and member.achievement_progress.length %}
{%- set doneCount = 0 -%}
{%- set totalStars = 0 -%}
{%- for a in member.achievement_progress -%}
  {%- if a.completed -%}{%- set doneCount = doneCount + 1 -%}{%- endif -%}
  {%- set totalStars = totalStars + (a.stars or 0) -%}
{%- endfor -%}
<section class="pl-section">
  <header>
    <div>
      <h2>Achievements</h2>
      <p>Clash Royale achievement progress captured by Elixir.</p>
    </div>
    <span class="pl-pill pl-pill--gold">{{ doneCount }} done · {{ totalStars }}★</span>
  </header>
  <div class="pl-ach">
    {% for a in member.achievement_progress %}
    {%- set aPct = ((a.value / a.target) * 100) | round if a.target else 100 -%}
    {%- if aPct > 100 -%}{%- set aPct = 100 -%}{%- endif -%}
    {%- set starsFilled = a.stars or 0 -%}
    <div class="pl-ach__row{% if a.completed %} pl-ach__row--done{% endif %}" title="{{ (a.info or '') | e }}">
      <div class="pl-ach__name">{{ a.name | e }}</div>
      <div class="pl-ach__stars{% if starsFilled == 0 %} pl-ach__stars--empty{% endif %}">{% for i in range(0, starsFilled) %}★{% endfor %}{% for i in range(0, 3 - starsFilled) %}☆{% endfor %}</div>
      <div class="pl-ach__bar"><div class="pl-ach__bar__fill{% if a.completed %} pl-ach__bar__fill--done{% endif %}" style="width:{{ aPct }}%"></div></div>
      <div class="pl-ach__pct">{{ aPct }}%</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
